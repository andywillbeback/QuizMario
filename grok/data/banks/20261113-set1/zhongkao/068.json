{"cards":[{"word":"on fire","pos":"prep.","meaning_zh":"着火","example_en":"Call for help if the kitchen is on fire.","example_zh":"如果厨房着火，就呼救。","scene":"中考","root_group":"prep.","ipa":"/ɒn faɪə/","related":["on","fire"]},{"word":"on foot","pos":"prep.","meaning_zh":"步行","example_en":"It takes ten minutes on foot.","example_zh":"步行要十分钟。","scene":"中考","root_group":"prep.","ipa":"/ɒn fʊt/","related":["on","foot"]},{"word":"on hand","pos":"prep.","meaning_zh":"在手头","example_en":"We have enough water on hand.","example_zh":"我们手头有足够的水。","scene":"中考","root_group":"prep.","ipa":"/ɒn hænd/","related":["on","hand"]},{"word":"on one’s own","pos":"prep.","meaning_zh":"靠自己","example_en":"She finished the model on her own.","example_zh":"她靠自己完成了模型。","scene":"中考","root_group":"prep.","ipa":"/ɒn wʌnz əʊn/","related":["on","own"]},{"word":"on sale","pos":"prep.","meaning_zh":"在出售；减价","example_en":"These shirts are on sale today.","example_zh":"这些衬衫今天减价出售。","scene":"中考","root_group":"prep.","ipa":"/ɒn seɪl/","related":["on","sale"]},{"word":"on show","pos":"prep.","meaning_zh":"公开展览","example_en":"New paintings are on show this week.","example_zh":"新画这周公开展览。","scene":"中考","root_group":"prep.","ipa":"/ɒn ʃəʊ/","related":["on","show"]},{"word":"on the internet","pos":"prep.","meaning_zh":"在网上","example_en":"I looked up the word on the Internet.","example_zh":"我在网上查了这个词。","scene":"中考","root_group":"prep.","ipa":"/ɒn ðə ˈɪntəˌnet/","related":["on","Internet"]},{"word":"on the left/right","pos":"prep.","meaning_zh":"在左/右边","example_en":"The bank is on the left.","example_zh":"银行在左边。","scene":"中考","root_group":"prep.","ipa":"/ɒn ðə left/ / /ɒn ðə raɪt/","related":["on","left","right"]},{"word":"on the phone","pos":"prep.","meaning_zh":"在打电话","example_en":"Mum is on the phone with Aunt Li.","example_zh":"妈妈在和李阿姨打电话。","scene":"中考","root_group":"prep.","ipa":"/ɒn ðə fəʊn/","related":["on","phone"]},{"word":"on the radio","pos":"prep.","meaning_zh":"通过收音机","example_en":"We heard the news on the radio.","example_zh":"我们从收音机里听到了新闻。","scene":"中考","root_group":"prep.","ipa":"/ɒn ðə ˈreɪdɪˌəʊ/","related":["on","radio"]},{"word":"on the wall","pos":"prep.","meaning_zh":"在墙上","example_en":"There is a map on the wall.","example_zh":"墙上有一张地图。","scene":"中考","root_group":"prep.","ipa":"/ɒn ðə wɔːl/","related":["on","wall"]},{"word":"on the way","pos":"prep.","meaning_zh":"在路上","example_en":"I bought bread on the way home.","example_zh":"我在回家的路上买了面包。","scene":"中考","root_group":"prep.","ipa":"/ɒn ðə weɪ/","related":["on","way"]},{"word":"on time","pos":"prep.","meaning_zh":"准时","example_en":"The train left on time.","example_zh":"火车准时离开了。","scene":"中考","root_group":"prep.","ipa":"/ɒn taɪm/","related":["on","time"]},{"word":"on tv","pos":"prep.","meaning_zh":"在电视上","example_en":"We watched the game on TV.","example_zh":"我们在电视上看了比赛。","scene":"中考","root_group":"prep.","ipa":"/ɒn ˌtiːˈviː/","related":["on","TV"]},{"word":"on vacation","pos":"prep.","meaning_zh":"在度假","example_en":"They are on vacation in Qingdao.","example_zh":"他们在青岛度假。","scene":"中考","root_group":"prep.","ipa":"/ɒn veɪˈkeɪʃən/","related":["on","vacation"]},{"word":"over and over again","pos":"prep.","meaning_zh":"一遍又一遍","example_en":"The child asked the same question over and over again.","example_zh":"孩子一遍又一遍地问同一个问题。","scene":"中考","root_group":"prep.","ipa":"/ˈəʊvə ænd ˈəʊvə əˈɡen/","related":["over","and","again"]},{"word":"thanks to","pos":"prep.","meaning_zh":"多亏","example_en":"Thanks to your map, we did not get lost.","example_zh":"多亏你的地图，我们没有迷路。","scene":"中考","root_group":"prep.","ipa":"/θæŋks tuː/","related":["thanks"]},{"word":"to be honest","pos":"prep.","meaning_zh":"说实话","example_en":"To be honest, I prefer the old song.","example_zh":"说实话，我更喜欢那首老歌。","scene":"中考","root_group":"prep.","ipa":"/tuː biː ˈɒnɪst/","related":["be","honest"]},{"word":"to one’s surprise","pos":"prep.","meaning_zh":"令某人吃惊的是","example_en":"To my surprise, the test was easy.","example_zh":"令我吃惊的是，测验很简单。","scene":"中考","root_group":"prep.","ipa":"/tuː wʌnz səˈpraɪz/","related":["surprise"]},{"word":"without doubt","pos":"prep.","meaning_zh":"毫无疑问","example_en":"Without doubt, she is our best runner.","example_zh":"毫无疑问，她是我们最好的赛跑选手。","scene":"中考","root_group":"prep.","ipa":"/wɪˈðaʊt daʊt/","related":["without","doubt"]},{"word":"a bit","pos":"det.","meaning_zh":"有点儿","example_en":"I feel a bit tired after the game.","example_zh":"比赛后我有点儿累。","scene":"中考","root_group":"det.","ipa":"/ə bɪt/","related":["bit"]},{"word":"a bit of","pos":"det.","meaning_zh":"一点点","example_en":"Add a bit of salt to the soup.","example_zh":"汤里加一点点盐。","scene":"中考","root_group":"det.","ipa":"/ə bɪt ɒv/","related":["bit"]},{"word":"a couple of","pos":"det.","meaning_zh":"两个；几个","example_en":"I will stay for a couple of days.","example_zh":"我会待上几天。","scene":"中考","root_group":"det.","ipa":"/ə ˈkʌpəl ɒv/","related":["couple"]},{"word":"a few","pos":"det.","meaning_zh":"一些（可数）","example_en":"A few students are still in the classroom.","example_zh":"一些学生还在教室里。","scene":"中考","root_group":"det.","ipa":"/ə fjuː/","related":["few"]},{"word":"a good/great many","pos":"det.","meaning_zh":"许多（可数）","example_en":"A good many birds rest by the lake.","example_zh":"许多鸟在湖边休息。","scene":"中考","root_group":"det.","ipa":"/ə ɡʊd ˈmeni/ / /ə ɡreɪt ˈmeni/","related":["good","great","many"]},{"word":"a kind of","pos":"det.","meaning_zh":"一种","example_en":"A panda is a kind of animal.","example_zh":"熊猫是一种动物。","scene":"中考","root_group":"det.","ipa":"/ə kaɪnd ɒv/","related":["kind"]},{"word":"a little","pos":"det.","meaning_zh":"一点（不可数）","example_en":"There is a little milk in the glass.","example_zh":"杯子里有一点牛奶。","scene":"中考","root_group":"det.","ipa":"/ə ˈlɪtəl/","related":["little"]},{"word":"a lot of","pos":"det.","meaning_zh":"许多","example_en":"We saw a lot of stars last night.","example_zh":"昨晚我们看见许多星星。","scene":"中考","root_group":"det.","ipa":"/ə lɒt ɒv/","related":["lot"]},{"word":"a number of","pos":"det.","meaning_zh":"若干","example_en":"A number of parents came to the show.","example_zh":"若干位家长来看了演出。","scene":"中考","root_group":"det.","ipa":"/ə ˈnʌmbə ɒv/","related":["number"]},{"word":"a pair of","pos":"det.","meaning_zh":"一双；一对","example_en":"I need a pair of sports shoes.","example_zh":"我需要一双运动鞋。","scene":"中考","root_group":"det.","ipa":"/ə peə ɒv/","related":["pair"]},{"word":"a piece of","pos":"det.","meaning_zh":"一张；一片","example_en":"Please give me a piece of paper.","example_zh":"请给我一张纸。","scene":"中考","root_group":"det.","ipa":"/ə piːs ɒv/","related":["piece"]},{"word":"a quarter past/to","pos":"det.","meaning_zh":"一刻（过或差）","example_en":"The class starts at a quarter past eight.","example_zh":"课在八点一刻开始。","scene":"中考","root_group":"det.","ipa":"/ə ˈkwɔːtə pɑːst/ / /ə ˈkwɔːtə tuː/","related":["quarter","past","to"]},{"word":"all in all","pos":"det.","meaning_zh":"总的来说","example_en":"All in all, it was a happy day.","example_zh":"总的来说，这是愉快的一天。","scene":"中考","root_group":"det.","ipa":"/ɔːl ɪn ɔːl/","related":["all"]},{"word":"all kinds of","pos":"det.","meaning_zh":"各种各样的","example_en":"The market sells all kinds of fruit.","example_zh":"市场卖各种各样的水果。","scene":"中考","root_group":"det.","ipa":"/ɔːl kaɪndz ɒv/","related":["all","kinds"]},{"word":"all of a sudden","pos":"det.","meaning_zh":"突然","example_en":"All of a sudden, the lights went out.","example_zh":"突然，灯灭了。","scene":"中考","root_group":"det.","ipa":"/ɔːl ɒv ə ˈsʌdən/","related":["all","sudden"]},{"word":"all over","pos":"det.","meaning_zh":"到处；全身","example_en":"There is paint all over his shirt.","example_zh":"他衬衫上到处都是颜料。","scene":"中考","root_group":"det.","ipa":"/ɔːl ˈəʊvə/","related":["all","over"]},{"word":"all over the world","pos":"det.","meaning_zh":"全世界","example_en":"People all over the world like football.","example_zh":"全世界的人都喜欢足球。","scene":"中考","root_group":"det.","ipa":"/ɔːl ˈəʊvə ðə wɜːld/","related":["all","over","world"]},{"word":"all right","pos":"det.","meaning_zh":"好的；没事","example_en":"If you feel all right, we can start.","example_zh":"如果你觉得没事，我们可以开始。","scene":"中考","root_group":"det.","ipa":"/ɔːl raɪt/","related":["all","right"]},{"word":"all the best","pos":"det.","meaning_zh":"万事如意","example_en":"All the best for your new school.","example_zh":"祝你在新学校万事如意。","scene":"中考","root_group":"det.","ipa":"/ɔːl ðə best/","related":["all","best"]},{"word":"all the time","pos":"det.","meaning_zh":"一直","example_en":"The baby cried all the time on the bus.","example_zh":"宝宝在公交车上一直哭。","scene":"中考","root_group":"det.","ipa":"/ɔːl ðə taɪm/","related":["all","time"]},{"word":"and so on","pos":"det.","meaning_zh":"等等","example_en":"We bought pens, paper, and so on.","example_zh":"我们买了笔、纸等等。","scene":"中考","root_group":"det.","ipa":"/ænd səʊ ɒn/","related":["and","so","on"]},{"word":"hundreds of","pos":"det.","meaning_zh":"数以百计的","example_en":"Hundreds of people waited outside.","example_zh":"数以百计的人在外面等。","scene":"中考","root_group":"det.","ipa":"/ˈhʌndrɪdz ɒv/","related":["hundreds"]},{"word":"more or less","pos":"det.","meaning_zh":"差不多","example_en":"The two bags are more or less the same.","example_zh":"两个包差不多一样。","scene":"中考","root_group":"det.","ipa":"/mɔː ɔː les/","related":["more","or","less"]},{"word":"plenty of","pos":"det.","meaning_zh":"大量的","example_en":"There is plenty of time before the film.","example_zh":"电影开始前还有大量时间。","scene":"中考","root_group":"det.","ipa":"/ˈplenti ɒv/","related":["plenty"]},{"word":"thousands of","pos":"det.","meaning_zh":"成千上万的","example_en":"Thousands of lights shine on the bridge.","example_zh":"桥上有成千上万盏灯。","scene":"中考","root_group":"det.","ipa":"/ˈθaʊzəndz ɒv/","related":["thousands"]}]}