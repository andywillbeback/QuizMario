{"cards":[{"word":"close to","pos":"prep.","meaning_zh":"在附近","example_en":"The bank is close to the post office.","example_zh":"银行在邮局附近。","scene":"中考","root_group":"prep.","ipa":"/kləʊs tuː/","related":["close"]},{"word":"far from","pos":"prep.","meaning_zh":"离……很远","example_en":"The village is far from the city.","example_zh":"村子离城市很远。","scene":"中考","root_group":"prep.","ipa":"/fɑː frɒm/","related":["far"]},{"word":"for example","pos":"prep.","meaning_zh":"举例来说","example_en":"Some sports, for example swimming, are easy to start.","example_zh":"有些运动，举例来说游泳，很容易开始。","scene":"中考","root_group":"prep.","ipa":"/fɔː ɪɡˈzɑːmpəl/","related":["example"]},{"word":"for sure","pos":"prep.","meaning_zh":"肯定地","example_en":"I do not know the price for sure.","example_zh":"我不能肯定价格。","scene":"中考","root_group":"prep.","ipa":"/fɔː ʃʊə/","related":["sure"]},{"word":"for the first time","pos":"prep.","meaning_zh":"第一次","example_en":"I saw the sea for the first time last summer.","example_zh":"去年夏天我第一次看见大海。","scene":"中考","root_group":"prep.","ipa":"/fɔː ðə fɜːst taɪm/","related":["first","time"]},{"word":"from now on","pos":"prep.","meaning_zh":"从现在起","example_en":"From now on, I will read before bed.","example_zh":"从现在起，我睡前要读书。","scene":"中考","root_group":"prep.","ipa":"/frɒm naʊ ɒn/","related":["now","on"]},{"word":"from then on","pos":"prep.","meaning_zh":"从那时起","example_en":"From then on, they became good friends.","example_zh":"从那时起，他们成了好朋友。","scene":"中考","root_group":"prep.","ipa":"/frɒm ðen ɒn/","related":["then","on"]},{"word":"from time to time","pos":"prep.","meaning_zh":"不时地","example_en":"She calls her grandma from time to time.","example_zh":"她不时给奶奶打电话。","scene":"中考","root_group":"prep.","ipa":"/frɒm taɪm tuː taɪm/","related":["time"]},{"word":"in a hurry","pos":"prep.","meaning_zh":"匆忙","example_en":"He left in a hurry and forgot his keys.","example_zh":"他匆忙离开，忘了钥匙。","scene":"中考","root_group":"prep.","ipa":"/ɪn ə ˈhʌri/","related":["hurry"]},{"word":"in a word","pos":"prep.","meaning_zh":"简言之","example_en":"In a word, the plan is too expensive.","example_zh":"简言之，这个计划太贵了。","scene":"中考","root_group":"prep.","ipa":"/ɪn ə wɜːd/","related":["word"]},{"word":"in addition","pos":"prep.","meaning_zh":"另外","example_en":"In addition, we need two more chairs.","example_zh":"另外，我们还需要两把椅子。","scene":"中考","root_group":"prep.","ipa":"/ɪn əˈdɪʃən/","related":["addition"]},{"word":"in all","pos":"prep.","meaning_zh":"总共","example_en":"There are thirty students in all.","example_zh":"总共有三十名学生。","scene":"中考","root_group":"prep.","ipa":"/ɪn ɔːl/","related":["all"]},{"word":"in bed","pos":"prep.","meaning_zh":"卧床","example_en":"You should stay in bed if you feel ill.","example_zh":"如果生病，你应该卧床休息。","scene":"中考","root_group":"prep.","ipa":"/ɪn bed/","related":["bed"]},{"word":"in case of","pos":"prep.","meaning_zh":"如果发生","example_en":"In case of fire, use the stairs.","example_zh":"如果发生火灾，走楼梯。","scene":"中考","root_group":"prep.","ipa":"/ɪn keɪs ɒv/","related":["case"]},{"word":"in common","pos":"prep.","meaning_zh":"共同的","example_en":"We have a lot in common.","example_zh":"我们有很多共同之处。","scene":"中考","root_group":"prep.","ipa":"/ɪn ˈkɒmən/","related":["common"]},{"word":"in control of","pos":"prep.","meaning_zh":"控制着","example_en":"She stayed in control of the boat.","example_zh":"她控制着那条船。","scene":"中考","root_group":"prep.","ipa":"/ɪn kənˈtrəʊl ɒv/","related":["control"]},{"word":"in danger","pos":"prep.","meaning_zh":"处于危险中","example_en":"The old bridge is in danger.","example_zh":"那座旧桥处于危险中。","scene":"中考","root_group":"prep.","ipa":"/ɪn ˈdeɪndʒə/","related":["danger"]},{"word":"in english","pos":"prep.","meaning_zh":"用英语","example_en":"Please write the answer in English.","example_zh":"请用英语写下答案。","scene":"中考","root_group":"prep.","ipa":"/ɪn ˈɪŋɡlɪʃ/","related":["English"]},{"word":"in fact","pos":"prep.","meaning_zh":"事实上","example_en":"In fact, the shop is just around the corner.","example_zh":"事实上，商店就在拐角处。","scene":"中考","root_group":"prep.","ipa":"/ɪn fækt/","related":["fact"]},{"word":"in front of","pos":"prep.","meaning_zh":"在……前面（外部）","example_en":"A dog sat in front of the gate.","example_zh":"一只狗坐在大门前面。","scene":"中考","root_group":"prep.","ipa":"/ɪn frʌnt ɒv/","related":["front"]},{"word":"in general","pos":"prep.","meaning_zh":"一般来说","example_en":"In general, buses here are on time.","example_zh":"一般来说，这里的公交准时。","scene":"中考","root_group":"prep.","ipa":"/ɪn ˈdʒenərəl/","related":["general"]},{"word":"in need","pos":"prep.","meaning_zh":"在困境中","example_en":"We collected coats for people in need.","example_zh":"我们为困境中的人募集了外套。","scene":"中考","root_group":"prep.","ipa":"/ɪn niːd/","related":["need"]},{"word":"in need of","pos":"prep.","meaning_zh":"需要","example_en":"The plant is in need of water.","example_zh":"这株植物需要水。","scene":"中考","root_group":"prep.","ipa":"/ɪn niːd ɒv/","related":["need"]},{"word":"in order to","pos":"prep.","meaning_zh":"为了","example_en":"She got up early in order to catch the train.","example_zh":"她早起是为了赶上火车。","scene":"中考","root_group":"prep.","ipa":"/ɪn ˈɔːdə tuː/","related":["order"]},{"word":"in pain","pos":"prep.","meaning_zh":"疼痛","example_en":"His arm was in pain after the fall.","example_zh":"摔倒后他的胳膊疼痛。","scene":"中考","root_group":"prep.","ipa":"/ɪn peɪn/","related":["pain"]},{"word":"in person","pos":"prep.","meaning_zh":"亲自","example_en":"You must sign the form in person.","example_zh":"你必须亲自在表上签名。","scene":"中考","root_group":"prep.","ipa":"/ɪn ˈpɜːsən/","related":["person"]},{"word":"in public","pos":"prep.","meaning_zh":"当众","example_en":"He does not like to sing in public.","example_zh":"他不喜欢当众唱歌。","scene":"中考","root_group":"prep.","ipa":"/ɪn ˈpʌblɪk/","related":["public"]},{"word":"in return","pos":"prep.","meaning_zh":"作为回报","example_en":"She helped me, and I cooked dinner in return.","example_zh":"她帮了我，我做饭作为回报。","scene":"中考","root_group":"prep.","ipa":"/ɪn rɪˈtɜːn/","related":["return"]},{"word":"in silence","pos":"prep.","meaning_zh":"沉默地","example_en":"We walked home in silence.","example_zh":"我们沉默地走回了家。","scene":"中考","root_group":"prep.","ipa":"/ɪn ˈsaɪləns/","related":["silence"]},{"word":"in surprise","pos":"prep.","meaning_zh":"惊讶地","example_en":"She looked up in surprise.","example_zh":"她惊讶地抬起头。","scene":"中考","root_group":"prep.","ipa":"/ɪn səˈpraɪz/","related":["surprise"]},{"word":"in that case","pos":"prep.","meaning_zh":"既然那样","example_en":"In that case, we can meet tomorrow.","example_zh":"既然那样，我们可以明天见。","scene":"中考","root_group":"prep.","ipa":"/ɪn ðæt keɪs/","related":["that","case"]},{"word":"in the end","pos":"prep.","meaning_zh":"最后","example_en":"In the end, they found the lost key.","example_zh":"最后他们找到了丢失的钥匙。","scene":"中考","root_group":"prep.","ipa":"/ɪn ðə end/","related":["end"]},{"word":"in the front of","pos":"prep.","meaning_zh":"在……前部（内部）","example_en":"The driver sits in the front of the bus.","example_zh":"司机坐在公交车的前部。","scene":"中考","root_group":"prep.","ipa":"/ɪn ðə frʌnt ɒv/","related":["front"]},{"word":"in the future","pos":"prep.","meaning_zh":"在将来","example_en":"I want to be a doctor in the future.","example_zh":"将来我想当医生。","scene":"中考","root_group":"prep.","ipa":"/ɪn ðə ˈfjuːtʃə/","related":["future"]},{"word":"in the middle of","pos":"prep.","meaning_zh":"在……中间","example_en":"The table is in the middle of the room.","example_zh":"桌子在房间中间。","scene":"中考","root_group":"prep.","ipa":"/ɪn ðə ˈmɪdəl ɒv/","related":["middle"]},{"word":"in the morning","pos":"prep.","meaning_zh":"在早上","example_en":"I brush my teeth in the morning.","example_zh":"我早上刷牙。","scene":"中考","root_group":"prep.","ipa":"/ɪn ðə ˈmɔːnɪŋ/","related":["morning"]},{"word":"in time","pos":"prep.","meaning_zh":"及时","example_en":"We got to the hall in time for the talk.","example_zh":"我们及时赶到礼堂听讲座。","scene":"中考","root_group":"prep.","ipa":"/ɪn taɪm/","related":["time"]},{"word":"in total","pos":"prep.","meaning_zh":"合计","example_en":"The tickets cost sixty yuan in total.","example_zh":"票价合计六十元。","scene":"中考","root_group":"prep.","ipa":"/ɪn ˈtəʊtəl/","related":["total"]},{"word":"in trouble","pos":"prep.","meaning_zh":"处于麻烦中","example_en":"Ask a teacher if you are in trouble.","example_zh":"如果遇到麻烦，就去问老师。","scene":"中考","root_group":"prep.","ipa":"/ɪn ˈtrʌbəl/","related":["trouble"]},{"word":"instead of","pos":"prep.","meaning_zh":"代替；而不是","example_en":"Let us walk instead of taking a taxi.","example_zh":"我们走路吧，而不是打车。","scene":"中考","root_group":"prep.","ipa":"/ɪnˈsted ɒv/","related":["instead"]},{"word":"next to","pos":"prep.","meaning_zh":"紧挨着","example_en":"I sit next to the window.","example_zh":"我坐在窗户旁边。","scene":"中考","root_group":"prep.","ipa":"/nekst tuː/","related":["next"]},{"word":"of course","pos":"prep.","meaning_zh":"当然","example_en":"Of course you can borrow my ruler.","example_zh":"你当然可以借我的尺子。","scene":"中考","root_group":"prep.","ipa":"/ɒv kɔːs/","related":["course"]},{"word":"on account of","pos":"prep.","meaning_zh":"由于","example_en":"The match stopped on account of the rain.","example_zh":"比赛由于下雨停了。","scene":"中考","root_group":"prep.","ipa":"/ɒn əˈkaʊnt ɒv/","related":["on","account"]},{"word":"on board","pos":"prep.","meaning_zh":"在船上；登机","example_en":"All the passengers are on board.","example_zh":"所有乘客都已登机。","scene":"中考","root_group":"prep.","ipa":"/ɒn bɔːd/","related":["on","board"]},{"word":"on business","pos":"prep.","meaning_zh":"出差","example_en":"Dad is in Shenzhen on business.","example_zh":"爸爸在深圳出差。","scene":"中考","root_group":"prep.","ipa":"/ɒn ˈbɪznəs/","related":["on","business"]},{"word":"on display","pos":"prep.","meaning_zh":"在展出","example_en":"The photos are on display in the hall.","example_zh":"照片在大厅展出。","scene":"中考","root_group":"prep.","ipa":"/ɒn dɪˈspleɪ/","related":["on","display"]},{"word":"on duty","pos":"prep.","meaning_zh":"值班","example_en":"Who is on duty today?","example_zh":"今天谁值班？","scene":"中考","root_group":"prep.","ipa":"/ɒn ˈdjuːti/","related":["on","duty"]}]}