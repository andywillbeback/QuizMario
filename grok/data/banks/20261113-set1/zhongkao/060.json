{"cards":[{"word":"too...to","pos":"conj.","meaning_zh":"太……而不能","example_en":"The soup is too hot to drink.","example_zh":"汤太烫，没法喝。","scene":"中考","root_group":"conj.","ipa":"/tuː … tuː/","related":["too"]},{"word":"up and down","pos":"conj.","meaning_zh":"上上下下","example_en":"The little boy jumped up and down.","example_zh":"小男孩上下跳个不停。","scene":"中考","root_group":"conj.","ipa":"/ʌp ænd daʊn/","related":["up","and","down"]},{"word":"used to","pos":"conj.","meaning_zh":"过去常常","example_en":"I used to walk to school.","example_zh":"我过去常常走路上学。","scene":"中考","root_group":"conj.","ipa":"/ˈjuːst tuː/","related":["used"]},{"word":"whether...or","pos":"conj.","meaning_zh":"是……还是","example_en":"I cannot tell whether it is tea or juice.","example_zh":"我分不清那是茶还是果汁。","scene":"中考","root_group":"conj.","ipa":"/ˈweðə … ɔː/","related":["whether","or"]},{"word":"year after year","pos":"conj.","meaning_zh":"年复一年","example_en":"Year after year, the tree grows taller.","example_zh":"年复一年，树长得更高了。","scene":"中考","root_group":"conj.","ipa":"/jɪə ˈɑːftə jɪə/","related":["year","after"]},{"word":"the day after tomorrow","pos":"n.","meaning_zh":"后天","example_en":"The match is the day after tomorrow.","example_zh":"比赛在后天。","scene":"中考","root_group":"n.","ipa":"/ðə deɪ ˈɑːftə təˈmɒrəʊ/","related":["day","after","tomorrow"]},{"word":"the day before yesterday","pos":"n.","meaning_zh":"前天","example_en":"I saw her the day before yesterday.","example_zh":"我前天见到了她。","scene":"中考","root_group":"n.","ipa":"/ðə deɪ bɪˈfɔː ˈjestəˌdeɪ/","related":["day","before","yesterday"]},{"word":"add to","pos":"v.","meaning_zh":"增添","example_en":"Her joke will add to the fun of the party.","example_zh":"她的笑话会给聚会增添乐趣。","scene":"中考","root_group":"v.","ipa":"/æd tuː/","related":["add"]},{"word":"add up to","pos":"v.","meaning_zh":"合计达","example_en":"The prices add up to forty yuan.","example_zh":"这些价格合计达四十元。","scene":"中考","root_group":"v.","ipa":"/æd ʌp tuː/","related":["add","up"]},{"word":"agree to","pos":"v.","meaning_zh":"同意（提议）","example_en":"We agree to the class plan.","example_zh":"我们同意这个班级计划。","scene":"中考","root_group":"v.","ipa":"/əˈɡriː tuː/","related":["agree"]},{"word":"agree with","pos":"v.","meaning_zh":"同意（某人）","example_en":"I agree with you on this point.","example_zh":"在这一点上我同意你。","scene":"中考","root_group":"v.","ipa":"/əˈɡriː wɪð/","related":["agree"]},{"word":"allow to","pos":"v.","meaning_zh":"允许做","example_en":"My parents allow me to ride to school.","example_zh":"父母允许我骑车上学。","scene":"中考","root_group":"v.","ipa":"/əˈlaʊ tuː/","related":["allow"]},{"word":"argue with","pos":"v.","meaning_zh":"与……争论","example_en":"Do not argue with the driver.","example_zh":"别和司机争论。","scene":"中考","root_group":"v.","ipa":"/ˈɑːɡjuː wɪð/","related":["argue"]},{"word":"arrive at","pos":"v.","meaning_zh":"到达（小地点）","example_en":"We arrive at the gate at eight.","example_zh":"我们八点到达门口。","scene":"中考","root_group":"v.","ipa":"/əˈraɪv æt/","related":["arrive"]},{"word":"arrive at/in a place","pos":"v.","meaning_zh":"到达某地","example_en":"Please call when you arrive at a place.","example_zh":"你到达某地时请打电话。","scene":"中考","root_group":"v.","ipa":"/əˈraɪv æt ə pleɪs/ / /əˈraɪv ɪn ə pleɪs/","related":["arrive","at","in","place"]},{"word":"arrive in","pos":"v.","meaning_zh":"到达（大地点）","example_en":"They arrive in Chengdu on Friday.","example_zh":"他们星期五到达成都。","scene":"中考","root_group":"v.","ipa":"/əˈraɪv ɪn/","related":["arrive"]},{"word":"ask for","pos":"v.","meaning_zh":"请求；要","example_en":"You can ask for help at the desk.","example_zh":"你可以在服务台请求帮助。","scene":"中考","root_group":"v.","ipa":"/ɑːsk fɔː/","related":["ask"]},{"word":"begin with","pos":"v.","meaning_zh":"以……开始","example_en":"The lesson will begin with a short song.","example_zh":"这节课将以一首短歌开始。","scene":"中考","root_group":"v.","ipa":"/bɪˈɡɪn wɪð/","related":["begin"]},{"word":"belong to","pos":"v.","meaning_zh":"属于","example_en":"Does this red cap belong to Lucy?","example_zh":"这顶红帽子属于露西吗？","scene":"中考","root_group":"v.","ipa":"/bɪˈlɒŋ tuː/","related":["belong"]},{"word":"call back","pos":"v.","meaning_zh":"回电话","example_en":"I will call back after dinner.","example_zh":"晚饭后我会回电话。","scene":"中考","root_group":"v.","ipa":"/kɔːl bæk/","related":["call","back"]},{"word":"call up","pos":"v.","meaning_zh":"打电话给","example_en":"Call me up if the plan changes.","example_zh":"如果计划变了，就打电话给我。","scene":"中考","root_group":"v.","ipa":"/kɔːl ʌp/","related":["call","up"]},{"word":"care about","pos":"v.","meaning_zh":"在意","example_en":"I care about my little brother.","example_zh":"我很在意弟弟。","scene":"中考","root_group":"v.","ipa":"/keə əˈbaʊt/","related":["care","about"]},{"word":"care for","pos":"v.","meaning_zh":"照料；喜欢","example_en":"Who will care for the cat this weekend?","example_zh":"这个周末谁来照料这只猫？","scene":"中考","root_group":"v.","ipa":"/keə fɔː/","related":["care"]},{"word":"carry on","pos":"v.","meaning_zh":"继续","example_en":"Let us carry on with the story.","example_zh":"我们继续这个故事吧。","scene":"中考","root_group":"v.","ipa":"/ˈkæri ɒn/","related":["carry","on"]},{"word":"carry out","pos":"v.","meaning_zh":"实施","example_en":"The team will carry out the survey.","example_zh":"这个小组将实施调查。","scene":"中考","root_group":"v.","ipa":"/ˈkæri aʊt/","related":["carry","out"]},{"word":"catch a cold","pos":"v.","meaning_zh":"患感冒","example_en":"Wear a coat so you do not catch a cold.","example_zh":"穿上外套，免得患感冒。","scene":"中考","root_group":"v.","ipa":"/kætʃ ə kəʊld/","related":["catch","cold"]},{"word":"catch up with","pos":"v.","meaning_zh":"赶上","example_en":"Run, or you cannot catch up with them.","example_zh":"快跑，不然你赶不上他们。","scene":"中考","root_group":"v.","ipa":"/kætʃ ʌp wɪð/","related":["catch","up"]},{"word":"change mind","pos":"v.","meaning_zh":"改变主意","example_en":"I may change my mind after lunch.","example_zh":"午饭后我可能改变主意。","scene":"中考","root_group":"v.","ipa":"/tʃeɪndʒ maɪnd/","related":["change","mind"]},{"word":"cheer up","pos":"v.","meaning_zh":"振作起来","example_en":"Cheer up. The sun will come out.","example_zh":"振作起来，太阳会出来的。","scene":"中考","root_group":"v.","ipa":"/tʃɪə ʌp/","related":["cheer","up"]},{"word":"clean up","pos":"v.","meaning_zh":"打扫干净","example_en":"We clean up the lab after class.","example_zh":"课后我们把实验室打扫干净。","scene":"中考","root_group":"v.","ipa":"/kliːn ʌp/","related":["clean","up"]},{"word":"come across","pos":"v.","meaning_zh":"偶然遇见","example_en":"I often come across old photos in this book.","example_zh":"我常常在这本书里偶然看到旧照片。","scene":"中考","root_group":"v.","ipa":"/kʌm əˈkrɒs/","related":["come","across"]},{"word":"come along","pos":"v.","meaning_zh":"一起来","example_en":"Come along with us to the park.","example_zh":"和我们一起来公园吧。","scene":"中考","root_group":"v.","ipa":"/kʌm əˈlɒŋ/","related":["come","along"]},{"word":"come back","pos":"v.","meaning_zh":"回来","example_en":"Come back before six, please.","example_zh":"请六点前回来。","scene":"中考","root_group":"v.","ipa":"/kʌm bæk/","related":["come","back"]},{"word":"come down","pos":"v.","meaning_zh":"下来；下降","example_en":"The price may come down next week.","example_zh":"下周价格可能会下降。","scene":"中考","root_group":"v.","ipa":"/kʌm daʊn/","related":["come","down"]},{"word":"come from","pos":"v.","meaning_zh":"来自","example_en":"These oranges come from the south.","example_zh":"这些橙子来自南方。","scene":"中考","root_group":"v.","ipa":"/kʌm frɒm/","related":["come"]},{"word":"come in","pos":"v.","meaning_zh":"进来","example_en":"Come in and sit by the window.","example_zh":"进来，坐到窗边。","scene":"中考","root_group":"v.","ipa":"/kʌm ɪn/","related":["come"]},{"word":"come on","pos":"v.","meaning_zh":"快点；加油","example_en":"Come on, we are almost there.","example_zh":"加油，我们快到了。","scene":"中考","root_group":"v.","ipa":"/kʌm ɒn/","related":["come","on"]},{"word":"come out","pos":"v.","meaning_zh":"出来；出版","example_en":"The new magazine will come out on Monday.","example_zh":"新杂志将在星期一出版。","scene":"中考","root_group":"v.","ipa":"/kʌm aʊt/","related":["come","out"]},{"word":"come over","pos":"v.","meaning_zh":"过来","example_en":"Come over to my house this evening.","example_zh":"今晚到我家来吧。","scene":"中考","root_group":"v.","ipa":"/kʌm ˈəʊvə/","related":["come","over"]},{"word":"come to","pos":"v.","meaning_zh":"来到","example_en":"We come to the museum at nine.","example_zh":"我们九点来到博物馆。","scene":"中考","root_group":"v.","ipa":"/kʌm tuː/","related":["come"]},{"word":"come true","pos":"v.","meaning_zh":"实现","example_en":"Her wish to see the sea may come true.","example_zh":"她看海的愿望也许会实现。","scene":"中考","root_group":"v.","ipa":"/kʌm truː/","related":["come","true"]},{"word":"come up","pos":"v.","meaning_zh":"发生；走上前","example_en":"A problem may come up during the trip.","example_zh":"途中可能会出现问题。","scene":"中考","root_group":"v.","ipa":"/kʌm ʌp/","related":["come","up"]},{"word":"come up with","pos":"v.","meaning_zh":"想出","example_en":"Can you come up with a better name?","example_zh":"你能想出一个更好的名字吗？","scene":"中考","root_group":"v.","ipa":"/kʌm ʌp wɪð/","related":["come","up"]},{"word":"cut down","pos":"v.","meaning_zh":"削减","example_en":"We should cut down on plastic bags.","example_zh":"我们应该少用塑料袋。","scene":"中考","root_group":"v.","ipa":"/kʌt daʊn/","related":["cut","down"]},{"word":"cut off","pos":"v.","meaning_zh":"切断","example_en":"The storm cut off the power.","example_zh":"暴风雨切断了电源。","scene":"中考","root_group":"v.","ipa":"/kʌt ɒf/","related":["cut","off"]},{"word":"cut up","pos":"v.","meaning_zh":"切碎","example_en":"Please cut up the apples for the salad.","example_zh":"请把苹果切碎做沙拉。","scene":"中考","root_group":"v.","ipa":"/kʌt ʌp/","related":["cut","up"]},{"word":"dance to","pos":"v.","meaning_zh":"跟着……跳舞","example_en":"They dance to a slow song.","example_zh":"他们跟着一首慢歌跳舞。","scene":"中考","root_group":"v.","ipa":"/dɑːns tuː/","related":["dance"]}]}