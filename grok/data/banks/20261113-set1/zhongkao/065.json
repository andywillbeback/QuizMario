{"cards":[{"word":"take a message","pos":"v.","meaning_zh":"捎个口信","example_en":"Can you take a message for Anna?","example_zh":"你能给安娜捎个口信吗？","scene":"中考","root_group":"v.","ipa":"/teɪk ə ˈmesɪdʒ/","related":["take","message"]},{"word":"take a photo","pos":"v.","meaning_zh":"拍照","example_en":"May I take a photo of the bridge?","example_zh":"我可以给这座桥拍照吗？","scene":"中考","root_group":"v.","ipa":"/teɪk ə ˈfəʊtəʊ/","related":["take","photo"]},{"word":"take a rest","pos":"v.","meaning_zh":"歇一歇","example_en":"You look tired. Take a rest.","example_zh":"你看起来累了，歇一歇。","scene":"中考","root_group":"v.","ipa":"/teɪk ə rest/","related":["take","rest"]},{"word":"take a shower","pos":"v.","meaning_zh":"淋浴","example_en":"I take a shower after basketball.","example_zh":"打完篮球我淋浴。","scene":"中考","root_group":"v.","ipa":"/teɪk ə ʃaʊə/","related":["take","shower"]},{"word":"take a taxi","pos":"v.","meaning_zh":"打出租车","example_en":"We take a taxi when it rains hard.","example_zh":"下大雨时我们打出租车。","scene":"中考","root_group":"v.","ipa":"/teɪk ə ˈtæksi/","related":["take","taxi"]},{"word":"take a vacation","pos":"v.","meaning_zh":"休假","example_en":"They take a vacation in August.","example_zh":"他们八月休假。","scene":"中考","root_group":"v.","ipa":"/teɪk ə veɪˈkeɪʃən/","related":["take","vacation"]},{"word":"take a walk","pos":"v.","meaning_zh":"去走走","example_en":"Grandpa will take a walk after breakfast.","example_zh":"爷爷早饭后会去走走。","scene":"中考","root_group":"v.","ipa":"/teɪk ə wɔːk/","related":["take","walk"]},{"word":"take action","pos":"v.","meaning_zh":"采取行动","example_en":"We must take action to save water.","example_zh":"我们必须采取行动节约用水。","scene":"中考","root_group":"v.","ipa":"/teɪk ˈækʃən/","related":["take","action"]},{"word":"take after","pos":"v.","meaning_zh":"长得像（长辈）","example_en":"The boy may take after his father.","example_zh":"这个男孩可能长得像他父亲。","scene":"中考","root_group":"v.","ipa":"/teɪk ˈɑːftə/","related":["take","after"]},{"word":"take an interest in","pos":"v.","meaning_zh":"对……产生兴趣","example_en":"She began to take an interest in robots.","example_zh":"她开始对机器人产生兴趣。","scene":"中考","root_group":"v.","ipa":"/teɪk ən ˈɪntrest ɪn/","related":["take","interest"]},{"word":"take away","pos":"v.","meaning_zh":"拿走","example_en":"Please take away the empty cups.","example_zh":"请把空杯子拿走。","scene":"中考","root_group":"v.","ipa":"/teɪk əˈweɪ/","related":["take","away"]},{"word":"take care","pos":"v.","meaning_zh":"保重","example_en":"Take care on the icy road.","example_zh":"结冰的路上要保重。","scene":"中考","root_group":"v.","ipa":"/teɪk keə/","related":["take","care"]},{"word":"take care of","pos":"v.","meaning_zh":"照料","example_en":"I take care of the class plants.","example_zh":"我照料班里的植物。","scene":"中考","root_group":"v.","ipa":"/teɪk keə ɒv/","related":["take","care"]},{"word":"take down","pos":"v.","meaning_zh":"记下；取下","example_en":"Take down the homework in your notebook.","example_zh":"把作业记在笔记本上。","scene":"中考","root_group":"v.","ipa":"/teɪk daʊn/","related":["take","down"]},{"word":"take medicine","pos":"v.","meaning_zh":"吃药","example_en":"Take medicine after meals.","example_zh":"饭后吃药。","scene":"中考","root_group":"v.","ipa":"/teɪk ˈmedsən/","related":["take","medicine"]},{"word":"take notes","pos":"v.","meaning_zh":"做笔记","example_en":"I take notes while the teacher talks.","example_zh":"老师讲课时我做笔记。","scene":"中考","root_group":"v.","ipa":"/teɪk nəʊts/","related":["take","notes"]},{"word":"take off","pos":"v.","meaning_zh":"起飞；脱下","example_en":"The plane will take off in ten minutes.","example_zh":"飞机十分钟后起飞。","scene":"中考","root_group":"v.","ipa":"/teɪk ɒf/","related":["take","off"]},{"word":"take one’s advice","pos":"v.","meaning_zh":"听从某人的建议","example_en":"You should take your teacher's advice.","example_zh":"你应该听从老师的建议。","scene":"中考","root_group":"v.","ipa":"/teɪk wʌnz ədˈvaɪs/","related":["take","advice"]},{"word":"take one’s temperature","pos":"v.","meaning_zh":"量体温","example_en":"The nurse will take your temperature.","example_zh":"护士会给你量体温。","scene":"中考","root_group":"v.","ipa":"/teɪk wʌnz ˈtemprɪtʃə/","related":["take","temperature"]},{"word":"take out","pos":"v.","meaning_zh":"取出","example_en":"Take out your pencil, please.","example_zh":"请把铅笔拿出来。","scene":"中考","root_group":"v.","ipa":"/teɪk aʊt/","related":["take","out"]},{"word":"take part in","pos":"v.","meaning_zh":"参加","example_en":"I will take part in the singing contest.","example_zh":"我将参加歌唱比赛。","scene":"中考","root_group":"v.","ipa":"/teɪk pɑːt ɪn/","related":["take","part"]},{"word":"take place","pos":"v.","meaning_zh":"发生","example_en":"The meeting will take place in Room 3.","example_zh":"会议将在 3 号房间举行。","scene":"中考","root_group":"v.","ipa":"/teɪk pleɪs/","related":["take","place"]},{"word":"take pride in","pos":"v.","meaning_zh":"为……感到自豪","example_en":"The school will take pride in its choir.","example_zh":"学校会为合唱团感到自豪。","scene":"中考","root_group":"v.","ipa":"/teɪk praɪd ɪn/","related":["take","pride"]},{"word":"take turns","pos":"v.","meaning_zh":"轮流","example_en":"We take turns to clean the blackboard.","example_zh":"我们轮流擦黑板。","scene":"中考","root_group":"v.","ipa":"/teɪk tɜːnz/","related":["take","turns"]},{"word":"take up","pos":"v.","meaning_zh":"开始从事；占据","example_en":"She wants to take up painting.","example_zh":"她想开始学画画。","scene":"中考","root_group":"v.","ipa":"/teɪk ʌp/","related":["take","up"]},{"word":"talk about","pos":"v.","meaning_zh":"谈论","example_en":"We talk about our weekend in class.","example_zh":"我们在课上谈论周末。","scene":"中考","root_group":"v.","ipa":"/tɔːk əˈbaʊt/","related":["talk","about"]},{"word":"talk to","pos":"v.","meaning_zh":"对……讲话","example_en":"I need to talk to the librarian.","example_zh":"我需要和图书管理员讲话。","scene":"中考","root_group":"v.","ipa":"/tɔːk tuː/","related":["talk"]},{"word":"talk with","pos":"v.","meaning_zh":"与……交谈","example_en":"She likes to talk with her neighbours.","example_zh":"她喜欢和邻居交谈。","scene":"中考","root_group":"v.","ipa":"/tɔːk wɪð/","related":["talk"]},{"word":"think about","pos":"v.","meaning_zh":"考虑","example_en":"Think about the question before you answer.","example_zh":"回答前先考虑这个问题。","scene":"中考","root_group":"v.","ipa":"/θɪŋk əˈbaʊt/","related":["think","about"]},{"word":"think of","pos":"v.","meaning_zh":"想到","example_en":"I cannot think of his name.","example_zh":"我想不起他的名字。","scene":"中考","root_group":"v.","ipa":"/θɪŋk ɒv/","related":["think"]},{"word":"think over","pos":"v.","meaning_zh":"仔细考虑","example_en":"Think over the offer tonight.","example_zh":"今晚仔细考虑这个提议。","scene":"中考","root_group":"v.","ipa":"/θɪŋk ˈəʊvə/","related":["think","over"]},{"word":"think twice","pos":"v.","meaning_zh":"三思","example_en":"Think twice before you spend all your money.","example_zh":"把钱全花掉之前要三思。","scene":"中考","root_group":"v.","ipa":"/θɪŋk twaɪs/","related":["think","twice"]},{"word":"think up","pos":"v.","meaning_zh":"想出（办法）","example_en":"Can you think up a game for the party?","example_zh":"你能为聚会想出一个游戏吗？","scene":"中考","root_group":"v.","ipa":"/θɪŋk ʌp/","related":["think","up"]},{"word":"try best","pos":"v.","meaning_zh":"尽最大努力","example_en":"We try our best in every match.","example_zh":"每场比赛我们都尽最大努力。","scene":"中考","root_group":"v.","ipa":"/traɪ best/","related":["try","best"]},{"word":"turn around","pos":"v.","meaning_zh":"转身","example_en":"Turn around and you will see the shop.","example_zh":"转过身你就能看见商店。","scene":"中考","root_group":"v.","ipa":"/tɜːn əˈraʊnd/","related":["turn","around"]},{"word":"turn back","pos":"v.","meaning_zh":"往回走","example_en":"We had to turn back because of the fog.","example_zh":"因为雾，我们不得不往回走。","scene":"中考","root_group":"v.","ipa":"/tɜːn bæk/","related":["turn","back"]},{"word":"turn down","pos":"v.","meaning_zh":"调低；拒绝","example_en":"Please turn down the music.","example_zh":"请把音乐调低。","scene":"中考","root_group":"v.","ipa":"/tɜːn daʊn/","related":["turn","down"]},{"word":"turn into","pos":"v.","meaning_zh":"变成","example_en":"Water can turn into ice.","example_zh":"水能变成冰。","scene":"中考","root_group":"v.","ipa":"/tɜːn ˈɪntʊ/","related":["turn"]},{"word":"turn left/right","pos":"v.","meaning_zh":"向左/右转","example_en":"Turn right at the bookshop.","example_zh":"在书店向右转。","scene":"中考","root_group":"v.","ipa":"/tɜːn left/ / /tɜːn raɪt/","related":["turn","left","right"]},{"word":"turn off","pos":"v.","meaning_zh":"关掉","example_en":"Turn off the lights when you leave.","example_zh":"离开时关掉灯。","scene":"中考","root_group":"v.","ipa":"/tɜːn ɒf/","related":["turn","off"]},{"word":"turn on","pos":"v.","meaning_zh":"打开","example_en":"Turn on the fan if you feel hot.","example_zh":"如果热，就打开风扇。","scene":"中考","root_group":"v.","ipa":"/tɜːn ɒn/","related":["turn","on"]},{"word":"turn out","pos":"v.","meaning_zh":"结果是","example_en":"The rumour did not turn out to be true.","example_zh":"谣言结果不是真的。","scene":"中考","root_group":"v.","ipa":"/tɜːn aʊt/","related":["turn","out"]},{"word":"turn over","pos":"v.","meaning_zh":"翻过来","example_en":"Turn over the page and read the map.","example_zh":"把这一页翻过来看地图。","scene":"中考","root_group":"v.","ipa":"/tɜːn ˈəʊvə/","related":["turn","over"]},{"word":"turn to","pos":"v.","meaning_zh":"转向；求助于","example_en":"You can turn to your teacher for help.","example_zh":"你可以向老师求助。","scene":"中考","root_group":"v.","ipa":"/tɜːn tuː/","related":["turn"]},{"word":"turn up","pos":"v.","meaning_zh":"出现；调高","example_en":"He did not turn up until noon.","example_zh":"他直到中午才出现。","scene":"中考","root_group":"v.","ipa":"/tɜːn ʌp/","related":["turn","up"]},{"word":"wait for","pos":"v.","meaning_zh":"等待","example_en":"Wait for me at the school gate.","example_zh":"在校门口等我。","scene":"中考","root_group":"v.","ipa":"/weɪt fɔː/","related":["wait"]},{"word":"wake up","pos":"v.","meaning_zh":"醒来","example_en":"I wake up before the alarm.","example_zh":"我在闹钟响之前醒来。","scene":"中考","root_group":"v.","ipa":"/weɪk ʌp/","related":["wake","up"]}]}