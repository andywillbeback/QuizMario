{"cards":[{"word":"be able to","pos":"adj.","meaning_zh":"能够","example_en":"She will be able to swim after a few lessons.","example_zh":"上几节课后，她将能够游泳。","scene":"中考","root_group":"adj.","ipa":"/biː ˈeɪbəl tuː/","related":["be","able"]},{"word":"be absent from","pos":"adj.","meaning_zh":"缺席","example_en":"Tom is absent from school because he has a cold.","example_zh":"汤姆因感冒缺席，没去上学。","scene":"中考","root_group":"adj.","ipa":"/biː ˈæbsənt frɒm/","related":["be","absent"]},{"word":"be afraid of","pos":"adj.","meaning_zh":"害怕","example_en":"My little sister is afraid of the dark.","example_zh":"我妹妹害怕黑。","scene":"中考","root_group":"adj.","ipa":"/biː əˈfreɪd ɒv/","related":["be","afraid"]},{"word":"be amazed at","pos":"adj.","meaning_zh":"对……感到惊叹","example_en":"We are amazed at the size of the new library.","example_zh":"我们对新图书馆的规模感到惊叹。","scene":"中考","root_group":"adj.","ipa":"/biː əˈmeɪzd æt/","related":["be","amazed"]},{"word":"be angry with","pos":"adj.","meaning_zh":"生某人的气","example_en":"Mum is angry with me for breaking the cup.","example_zh":"妈妈因为我打碎杯子而生气。","scene":"中考","root_group":"adj.","ipa":"/biː ˈæŋɡri wɪð/","related":["be","angry"]},{"word":"be bad at","pos":"adj.","meaning_zh":"不擅长","example_en":"I am bad at drawing maps.","example_zh":"我不擅长画地图。","scene":"中考","root_group":"adj.","ipa":"/biː bæd æt/","related":["be","bad"]},{"word":"be bad for","pos":"adj.","meaning_zh":"对……不利","example_en":"Too much candy is bad for your teeth.","example_zh":"糖吃太多对牙齿不利。","scene":"中考","root_group":"adj.","ipa":"/biː bæd fɔː/","related":["be","bad"]},{"word":"be based on","pos":"adj.","meaning_zh":"以……为根据","example_en":"The story is based on a real trip.","example_zh":"这个故事以一次真实的旅行为根据。","scene":"中考","root_group":"adj.","ipa":"/biː beɪst ɒn/","related":["be","based","on"]},{"word":"be busy with","pos":"adj.","meaning_zh":"忙于","example_en":"Dad is busy with his work this week.","example_zh":"爸爸这周忙于工作。","scene":"中考","root_group":"adj.","ipa":"/biː ˈbɪzi wɪð/","related":["be","busy"]},{"word":"be careful about","pos":"adj.","meaning_zh":"留意","example_en":"Be careful about the time, or we will be late.","example_zh":"留意时间，不然我们会迟到。","scene":"中考","root_group":"adj.","ipa":"/biː ˈkeəfəl əˈbaʊt/","related":["be","careful","about"]},{"word":"be careful of","pos":"adj.","meaning_zh":"当心","example_en":"Be careful of the wet floor.","example_zh":"当心湿地板。","scene":"中考","root_group":"adj.","ipa":"/biː ˈkeəfəl ɒv/","related":["be","careful"]},{"word":"be close to","pos":"adj.","meaning_zh":"接近","example_en":"Our flat is close to the metro station.","example_zh":"我们的公寓接近地铁站。","scene":"中考","root_group":"adj.","ipa":"/biː kləʊs tuː/","related":["be","close"]},{"word":"be confident in","pos":"adj.","meaning_zh":"对……有信心","example_en":"She is confident in her spoken English.","example_zh":"她对自己的英语口语有信心。","scene":"中考","root_group":"adj.","ipa":"/biː ˈkɒnfɪdənt ɪn/","related":["be","confident"]},{"word":"be connected with","pos":"adj.","meaning_zh":"与……有关联","example_en":"This question is connected with yesterday's lesson.","example_zh":"这道题与昨天的课有关联。","scene":"中考","root_group":"adj.","ipa":"/biː kəˈnektɪd wɪð/","related":["be","connected"]},{"word":"be covered with","pos":"adj.","meaning_zh":"覆盖着","example_en":"The hills are covered with snow in January.","example_zh":"一月里山丘覆盖着雪。","scene":"中考","root_group":"adj.","ipa":"/biː ˈkʌvəd wɪð/","related":["be","covered"]},{"word":"be crazy about","pos":"adj.","meaning_zh":"对着迷","example_en":"My brother is crazy about basketball.","example_zh":"我弟弟对篮球着迷。","scene":"中考","root_group":"adj.","ipa":"/biː ˈkreɪzi əˈbaʊt/","related":["be","crazy","about"]},{"word":"be different from","pos":"adj.","meaning_zh":"与……不同","example_en":"City life is different from life in a town.","example_zh":"城市生活与小镇生活不同。","scene":"中考","root_group":"adj.","ipa":"/biː ˈdɪfrənt frɒm/","related":["be","different"]},{"word":"be excited about","pos":"adj.","meaning_zh":"对……感到兴奋","example_en":"The class is excited about the school trip.","example_zh":"全班对学校郊游感到兴奋。","scene":"中考","root_group":"adj.","ipa":"/biː ɪkˈsaɪtɪd əˈbaʊt/","related":["be","excited","about"]},{"word":"be familiar with","pos":"adj.","meaning_zh":"熟悉","example_en":"Are you familiar with this song?","example_zh":"你熟悉这首歌吗？","scene":"中考","root_group":"adj.","ipa":"/biː fəˈmɪlɪə wɪð/","related":["be","familiar"]},{"word":"be famous for","pos":"adj.","meaning_zh":"因……闻名","example_en":"Hangzhou is famous for its lake.","example_zh":"杭州因西湖闻名。","scene":"中考","root_group":"adj.","ipa":"/biː ˈfeɪməs fɔː/","related":["be","famous"]},{"word":"be filled with","pos":"adj.","meaning_zh":"被装满","example_en":"The box is filled with old books.","example_zh":"箱子被旧书装满了。","scene":"中考","root_group":"adj.","ipa":"/biː fɪld wɪð/","related":["be","filled"]},{"word":"be fond of","pos":"adj.","meaning_zh":"喜爱","example_en":"Grandma is fond of morning walks.","example_zh":"奶奶喜爱早晨散步。","scene":"中考","root_group":"adj.","ipa":"/biː fɒnd ɒv/","related":["be","fond"]},{"word":"be friendly to","pos":"adj.","meaning_zh":"对……友好","example_en":"Please be friendly to new students.","example_zh":"请对新同学友好。","scene":"中考","root_group":"adj.","ipa":"/biː ˈfrendli tuː/","related":["be","friendly"]},{"word":"be full of","pos":"adj.","meaning_zh":"充满","example_en":"The park is full of families on Sunday.","example_zh":"星期天公园里充满了家人。","scene":"中考","root_group":"adj.","ipa":"/biː fʊl ɒv/","related":["be","full"]},{"word":"be good at","pos":"adj.","meaning_zh":"擅长","example_en":"Anna is good at maths and music.","example_zh":"安娜擅长数学和音乐。","scene":"中考","root_group":"adj.","ipa":"/biː ɡʊd æt/","related":["be","good"]},{"word":"be good for","pos":"adj.","meaning_zh":"对……有益","example_en":"Vegetables are good for your health.","example_zh":"蔬菜对健康有益。","scene":"中考","root_group":"adj.","ipa":"/biː ɡʊd fɔː/","related":["be","good"]},{"word":"be harmful to","pos":"adj.","meaning_zh":"有害于","example_en":"Smoke is harmful to children.","example_zh":"烟有害于儿童。","scene":"中考","root_group":"adj.","ipa":"/biː ˈhɑːmfəl tuː/","related":["be","harmful"]},{"word":"be interested in","pos":"adj.","meaning_zh":"对……感兴趣","example_en":"He is interested in science stories.","example_zh":"他对科学故事感兴趣。","scene":"中考","root_group":"adj.","ipa":"/biː ˈɪntrestɪd ɪn/","related":["be","interested"]},{"word":"be known as","pos":"adj.","meaning_zh":"被称为","example_en":"She is known as a kind class monitor.","example_zh":"她被称为一位和气的班长。","scene":"中考","root_group":"adj.","ipa":"/biː nəʊn æz/","related":["be","known"]},{"word":"be known for","pos":"adj.","meaning_zh":"因……出名","example_en":"The shop is known for fresh bread.","example_zh":"这家店因新鲜面包出名。","scene":"中考","root_group":"adj.","ipa":"/biː nəʊn fɔː/","related":["be","known"]},{"word":"be late for","pos":"adj.","meaning_zh":"迟到","example_en":"Do not be late for the morning meeting.","example_zh":"早上的会别迟到。","scene":"中考","root_group":"adj.","ipa":"/biː leɪt fɔː/","related":["be","late"]},{"word":"be made from","pos":"adj.","meaning_zh":"由……做成（看不出原料）","example_en":"This paper is made from wood.","example_zh":"这种纸由木头做成，看不出原料。","scene":"中考","root_group":"adj.","ipa":"/biː meɪd frɒm/","related":["be","made"]},{"word":"be made in","pos":"adj.","meaning_zh":"产于某地","example_en":"The toy is made in Guangzhou.","example_zh":"这个玩具产于广州。","scene":"中考","root_group":"adj.","ipa":"/biː meɪd ɪn/","related":["be","made"]},{"word":"be made of","pos":"adj.","meaning_zh":"由……制成（看得出原料）","example_en":"The desk is made of wood.","example_zh":"这张桌子由木头制成，看得出原料。","scene":"中考","root_group":"adj.","ipa":"/biː meɪd ɒv/","related":["be","made"]},{"word":"be nervous about","pos":"adj.","meaning_zh":"对……紧张","example_en":"I am nervous about the oral test.","example_zh":"我对口试感到紧张。","scene":"中考","root_group":"adj.","ipa":"/biː ˈnɜːvəs əˈbaʊt/","related":["be","nervous","about"]},{"word":"be patient with","pos":"adj.","meaning_zh":"对……有耐心","example_en":"A good teacher is patient with students.","example_zh":"好老师对学生有耐心。","scene":"中考","root_group":"adj.","ipa":"/biː ˈpeɪʃənt wɪð/","related":["be","patient"]},{"word":"be pleased with","pos":"adj.","meaning_zh":"对……感到高兴","example_en":"Dad is pleased with my drawing.","example_zh":"爸爸对我的画感到高兴。","scene":"中考","root_group":"adj.","ipa":"/biː pliːzd wɪð/","related":["be","pleased"]},{"word":"be polite to","pos":"adj.","meaning_zh":"对……有礼貌","example_en":"We should be polite to guests.","example_zh":"我们应当对客人有礼貌。","scene":"中考","root_group":"adj.","ipa":"/biː pəˈlaɪt tuː/","related":["be","polite"]},{"word":"be popular with","pos":"adj.","meaning_zh":"受……欢迎","example_en":"The club is popular with Grade 8.","example_zh":"这个社团受八年级欢迎。","scene":"中考","root_group":"adj.","ipa":"/biː ˈpɒpjʊlə wɪð/","related":["be","popular"]},{"word":"be proud of","pos":"adj.","meaning_zh":"为……骄傲","example_en":"We are proud of our school team.","example_zh":"我们为校队骄傲。","scene":"中考","root_group":"adj.","ipa":"/biː praʊd ɒv/","related":["be","proud"]},{"word":"be ready for","pos":"adj.","meaning_zh":"为……做好准备","example_en":"Are you ready for the sports day?","example_zh":"你为运动会做好准备了吗？","scene":"中考","root_group":"adj.","ipa":"/biː ˈredi fɔː/","related":["be","ready"]},{"word":"be related to","pos":"adj.","meaning_zh":"与……相关","example_en":"This word is related to travel.","example_zh":"这个词与旅行相关。","scene":"中考","root_group":"adj.","ipa":"/biː rɪˈleɪtɪd tuː/","related":["be","related"]},{"word":"be responsible for","pos":"adj.","meaning_zh":"对……负责","example_en":"I am responsible for watering the plants.","example_zh":"我负责给植物浇水。","scene":"中考","root_group":"adj.","ipa":"/biː rɪˈspɒnsɪbəl fɔː/","related":["be","responsible"]},{"word":"be rude to","pos":"adj.","meaning_zh":"对……无礼","example_en":"It is wrong to be rude to classmates.","example_zh":"对同学无礼是不对的。","scene":"中考","root_group":"adj.","ipa":"/biː ruːd tuː/","related":["be","rude"]},{"word":"be satisfied with","pos":"adj.","meaning_zh":"对……满意","example_en":"The coach is satisfied with our practice.","example_zh":"教练对我们的练习满意。","scene":"中考","root_group":"adj.","ipa":"/biː ˈsætɪˌsfaɪd wɪð/","related":["be","satisfied"]},{"word":"be serious about","pos":"adj.","meaning_zh":"认真对待","example_en":"She is serious about learning the piano.","example_zh":"她认真对待学钢琴。","scene":"中考","root_group":"adj.","ipa":"/biː ˈsɪərɪəs əˈbaʊt/","related":["be","serious","about"]},{"word":"be short of","pos":"adj.","meaning_zh":"缺少","example_en":"The team is short of one player.","example_zh":"队里缺少一名队员。","scene":"中考","root_group":"adj.","ipa":"/biː ʃɔːt ɒv/","related":["be","short"]}]}