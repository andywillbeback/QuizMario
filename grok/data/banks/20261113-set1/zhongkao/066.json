{"cards":[{"word":"would like to","pos":"v.","meaning_zh":"想要","example_en":"I would like to order a bowl of noodles.","example_zh":"我想要一碗面条。","scene":"中考","root_group":"v.","ipa":"/wʊd laɪk tuː/","related":["would","like"]},{"word":"write to","pos":"v.","meaning_zh":"给……写信","example_en":"I write to my cousin once a month.","example_zh":"我每个月给表弟写一封信。","scene":"中考","root_group":"v.","ipa":"/raɪt tuː/","related":["write"]},{"word":"after all","pos":"prep.","meaning_zh":"毕竟","example_en":"Do not be sad. It is a game after all.","example_zh":"别难过，这毕竟只是一场比赛。","scene":"中考","root_group":"prep.","ipa":"/ˈɑːftə ɔːl/","related":["after","all"]},{"word":"after class","pos":"prep.","meaning_zh":"课后","example_en":"We play ping-pong after class.","example_zh":"我们课后打乒乓球。","scene":"中考","root_group":"prep.","ipa":"/ˈɑːftə klɑːs/","related":["after","class"]},{"word":"ahead of","pos":"prep.","meaning_zh":"在……前面","example_en":"She finished ahead of the others.","example_zh":"她比其他人先完成。","scene":"中考","root_group":"prep.","ipa":"/əˈhed ɒv/","related":["ahead"]},{"word":"as a result","pos":"prep.","meaning_zh":"结果","example_en":"He slept late. As a result, he missed the bus.","example_zh":"他睡晚了，结果没赶上公交。","scene":"中考","root_group":"prep.","ipa":"/æz ə rɪˈzʌlt/","related":["result"]},{"word":"as for","pos":"prep.","meaning_zh":"至于","example_en":"I like rice. As for noodles, I can eat a little.","example_zh":"我喜欢米饭。至于面条，我能吃一点。","scene":"中考","root_group":"prep.","ipa":"/æz fɔː/","related":["as","for"]},{"word":"as usual","pos":"prep.","meaning_zh":"像往常一样","example_en":"As usual, she arrived five minutes early.","example_zh":"像往常一样，她早到了五分钟。","scene":"中考","root_group":"prep.","ipa":"/æz ˈjuːʒuːəl/","related":["usual"]},{"word":"as well","pos":"prep.","meaning_zh":"也","example_en":"I can skate, and my cousin can skate as well.","example_zh":"我会滑冰，我表弟也会。","scene":"中考","root_group":"prep.","ipa":"/æz wel/","related":["well"]},{"word":"as well as","pos":"prep.","meaning_zh":"也；和","example_en":"She speaks French as well as English.","example_zh":"她会说法语，也会说英语。","scene":"中考","root_group":"prep.","ipa":"/æz wel æz/","related":["well"]},{"word":"at a time","pos":"prep.","meaning_zh":"一次","example_en":"Please come in two at a time.","example_zh":"请一次进两个人。","scene":"中考","root_group":"prep.","ipa":"/æt ə taɪm/","related":["time"]},{"word":"at birth","pos":"prep.","meaning_zh":"出生时","example_en":"The panda was tiny at birth.","example_zh":"这只熊猫出生时很小。","scene":"中考","root_group":"prep.","ipa":"/æt bɜːθ/","related":["birth"]},{"word":"at christmas","pos":"prep.","meaning_zh":"在圣诞节","example_en":"We visit our grandparents at Christmas.","example_zh":"我们在圣诞节去看祖父母。","scene":"中考","root_group":"prep.","ipa":"/æt ˈkrɪsməs/","related":["Christmas"]},{"word":"at first","pos":"prep.","meaning_zh":"起初","example_en":"At first, the map looked hard.","example_zh":"起初，这张地图看起来很难。","scene":"中考","root_group":"prep.","ipa":"/æt fɜːst/","related":["first"]},{"word":"at home","pos":"prep.","meaning_zh":"在家","example_en":"I usually read at home on Friday.","example_zh":"我星期五通常在家看书。","scene":"中考","root_group":"prep.","ipa":"/æt həʊm/","related":["home"]},{"word":"at last","pos":"prep.","meaning_zh":"终于","example_en":"At last, the rain stopped.","example_zh":"雨终于停了。","scene":"中考","root_group":"prep.","ipa":"/æt lɑːst/","related":["last"]},{"word":"at least","pos":"prep.","meaning_zh":"至少","example_en":"The trip takes at least two hours.","example_zh":"这趟路至少要两小时。","scene":"中考","root_group":"prep.","ipa":"/æt liːst/","related":["least"]},{"word":"at most","pos":"prep.","meaning_zh":"至多","example_en":"The bag costs twenty yuan at most.","example_zh":"这个包至多二十元。","scene":"中考","root_group":"prep.","ipa":"/æt məʊst/","related":["most"]},{"word":"at night","pos":"prep.","meaning_zh":"在夜里","example_en":"Stars are bright at night.","example_zh":"夜里星星很亮。","scene":"中考","root_group":"prep.","ipa":"/æt naɪt/","related":["night"]},{"word":"at noon","pos":"prep.","meaning_zh":"在中午","example_en":"We eat lunch at noon.","example_zh":"我们中午吃午饭。","scene":"中考","root_group":"prep.","ipa":"/æt nuːn/","related":["noon"]},{"word":"at once","pos":"prep.","meaning_zh":"马上","example_en":"The bell rang, and we stood up at once.","example_zh":"铃响了，我们马上站起来。","scene":"中考","root_group":"prep.","ipa":"/æt wʌns/","related":["once"]},{"word":"at present","pos":"prep.","meaning_zh":"目前","example_en":"At present, she lives with her aunt.","example_zh":"目前她和姑姑住在一起。","scene":"中考","root_group":"prep.","ipa":"/æt ˈprezənt/","related":["present"]},{"word":"at school","pos":"prep.","meaning_zh":"在学校","example_en":"He is at school until four.","example_zh":"他在学校待到四点。","scene":"中考","root_group":"prep.","ipa":"/æt skuːl/","related":["school"]},{"word":"at table","pos":"prep.","meaning_zh":"在用餐","example_en":"Do not talk with food in your mouth at table.","example_zh":"用餐时嘴里有食物就别说话。","scene":"中考","root_group":"prep.","ipa":"/æt ˈteɪbəl/","related":["table"]},{"word":"at that time","pos":"prep.","meaning_zh":"在那时","example_en":"I was ten at that time.","example_zh":"那时我十岁。","scene":"中考","root_group":"prep.","ipa":"/æt ðæt taɪm/","related":["that","time"]},{"word":"at the age of","pos":"prep.","meaning_zh":"在……岁时","example_en":"She started piano at the age of six.","example_zh":"她六岁开始学钢琴。","scene":"中考","root_group":"prep.","ipa":"/æt ðə eɪdʒ ɒv/","related":["age"]},{"word":"at the end of","pos":"prep.","meaning_zh":"在……末端","example_en":"We will have a test at the end of the month.","example_zh":"我们月底有一次测验。","scene":"中考","root_group":"prep.","ipa":"/æt ðə end ɒv/","related":["end"]},{"word":"at the moment","pos":"prep.","meaning_zh":"眼下","example_en":"I am busy at the moment.","example_zh":"我眼下很忙。","scene":"中考","root_group":"prep.","ipa":"/æt ðə ˈməʊmənt/","related":["moment"]},{"word":"at the same time","pos":"prep.","meaning_zh":"同时","example_en":"They laughed and cried at the same time.","example_zh":"他们同时又笑又叫。","scene":"中考","root_group":"prep.","ipa":"/æt ðə seɪm taɪm/","related":["same","time"]},{"word":"at times","pos":"prep.","meaning_zh":"有时","example_en":"It is windy at times in spring.","example_zh":"春天有时会刮风。","scene":"中考","root_group":"prep.","ipa":"/æt taɪmz/","related":["times"]},{"word":"at work","pos":"prep.","meaning_zh":"在上班","example_en":"My aunt is at work on Saturday.","example_zh":"我阿姨星期六在上班。","scene":"中考","root_group":"prep.","ipa":"/æt wɜːk/","related":["work"]},{"word":"because of","pos":"prep.","meaning_zh":"因为","example_en":"We stayed in because of the storm.","example_zh":"因为暴风雨，我们待在室内。","scene":"中考","root_group":"prep.","ipa":"/bɪˈkɒz ɒv/","related":["because"]},{"word":"by accident","pos":"prep.","meaning_zh":"偶然","example_en":"I met my old friend by accident.","example_zh":"我偶然遇到了老朋友。","scene":"中考","root_group":"prep.","ipa":"/baɪ ˈæksɪdənt/","related":["accident"]},{"word":"by air","pos":"prep.","meaning_zh":"乘飞机","example_en":"They went to Beijing by air.","example_zh":"他们乘飞机去了北京。","scene":"中考","root_group":"prep.","ipa":"/baɪ eə/","related":["air"]},{"word":"by bike","pos":"prep.","meaning_zh":"骑自行车","example_en":"I go to the shop by bike.","example_zh":"我骑自行车去商店。","scene":"中考","root_group":"prep.","ipa":"/baɪ baɪk/","related":["bike"]},{"word":"by bus","pos":"prep.","meaning_zh":"乘公交","example_en":"She comes to school by bus.","example_zh":"她乘公交来上学。","scene":"中考","root_group":"prep.","ipa":"/baɪ bʌs/","related":["bus"]},{"word":"by chance","pos":"prep.","meaning_zh":"碰巧","example_en":"By chance, the shop was still open.","example_zh":"碰巧商店还开着。","scene":"中考","root_group":"prep.","ipa":"/baɪ tʃɑːns/","related":["chance"]},{"word":"by hand","pos":"prep.","meaning_zh":"用手工","example_en":"Grandma made the scarf by hand.","example_zh":"奶奶用手工织了这条围巾。","scene":"中考","root_group":"prep.","ipa":"/baɪ hænd/","related":["hand"]},{"word":"by mistake","pos":"prep.","meaning_zh":"错误地","example_en":"I took his book by mistake.","example_zh":"我错拿了他的书。","scene":"中考","root_group":"prep.","ipa":"/baɪ mɪˈsteɪk/","related":["mistake"]},{"word":"by oneself","pos":"prep.","meaning_zh":"独自","example_en":"He can cook a meal by himself.","example_zh":"他能独自做一顿饭。","scene":"中考","root_group":"prep.","ipa":"/baɪ wʌnˈself/","related":["oneself"]},{"word":"by ship","pos":"prep.","meaning_zh":"乘船","example_en":"We travelled to the island by ship.","example_zh":"我们乘船去了那个岛。","scene":"中考","root_group":"prep.","ipa":"/baɪ ʃɪp/","related":["ship"]},{"word":"by subway","pos":"prep.","meaning_zh":"乘地铁","example_en":"It is faster to go by subway.","example_zh":"乘地铁更快。","scene":"中考","root_group":"prep.","ipa":"/baɪ ˈsʌbweɪ/","related":["subway"]},{"word":"by taxi","pos":"prep.","meaning_zh":"乘出租车","example_en":"They went to the station by taxi.","example_zh":"他们乘出租车去车站。","scene":"中考","root_group":"prep.","ipa":"/baɪ ˈtæksi/","related":["taxi"]},{"word":"by the end of","pos":"prep.","meaning_zh":"到……结束时","example_en":"Finish the poster by the end of Friday.","example_zh":"星期五结束前完成海报。","scene":"中考","root_group":"prep.","ipa":"/baɪ ðə end ɒv/","related":["end"]},{"word":"by the way","pos":"prep.","meaning_zh":"顺便说","example_en":"By the way, the library closes at five.","example_zh":"顺便说一下，图书馆五点关门。","scene":"中考","root_group":"prep.","ipa":"/baɪ ðə weɪ/","related":["way"]},{"word":"by train","pos":"prep.","meaning_zh":"乘火车","example_en":"My uncle comes by train.","example_zh":"我叔叔乘火车来。","scene":"中考","root_group":"prep.","ipa":"/baɪ treɪn/","related":["train"]},{"word":"by turns","pos":"prep.","meaning_zh":"轮番","example_en":"We clean the room by turns.","example_zh":"我们轮番打扫房间。","scene":"中考","root_group":"prep.","ipa":"/baɪ tɜːnz/","related":["turns"]}]}