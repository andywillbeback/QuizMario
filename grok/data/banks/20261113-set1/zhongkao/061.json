{"cards":[{"word":"day and night","pos":"v.","meaning_zh":"日日夜夜","example_en":"The nurses work day and night.","example_zh":"护士们日日夜夜地工作。","scene":"中考","root_group":"v.","ipa":"/deɪ ænd naɪt/","related":["day","and","night"]},{"word":"deal with","pos":"v.","meaning_zh":"处理","example_en":"I do not know how to deal with this noise.","example_zh":"我不知道怎么处理这噪音。","scene":"中考","root_group":"v.","ipa":"/diːl wɪð/","related":["deal"]},{"word":"depend on","pos":"v.","meaning_zh":"依靠","example_en":"Plants depend on water and light.","example_zh":"植物依靠水和光。","scene":"中考","root_group":"v.","ipa":"/dɪˈpend ɒn/","related":["depend","on"]},{"word":"die from","pos":"v.","meaning_zh":"死于（外因）","example_en":"People can die from a bad accident.","example_zh":"人可能死于严重事故。","scene":"中考","root_group":"v.","ipa":"/daɪ frɒm/","related":["die"]},{"word":"die of","pos":"v.","meaning_zh":"死于（疾病等）","example_en":"In old stories, people die of a high fever.","example_zh":"旧故事里，人会死于高烧。","scene":"中考","root_group":"v.","ipa":"/daɪ ɒv/","related":["die"]},{"word":"die out","pos":"v.","meaning_zh":"灭绝","example_en":"Some animals may die out if we do nothing.","example_zh":"如果我们什么都不做，有些动物可能会灭绝。","scene":"中考","root_group":"v.","ipa":"/daɪ aʊt/","related":["die","out"]},{"word":"do one’s best","pos":"v.","meaning_zh":"尽某人最大努力","example_en":"I will do my best in the exam.","example_zh":"考试中我会尽最大努力。","scene":"中考","root_group":"v.","ipa":"/duː wʌnz best/","related":["do","best"]},{"word":"do well in","pos":"v.","meaning_zh":"在……做得好","example_en":"She can do well in history.","example_zh":"她能把历史学好。","scene":"中考","root_group":"v.","ipa":"/duː wel ɪn/","related":["do","well"]},{"word":"dream of","pos":"v.","meaning_zh":"梦想","example_en":"Many children dream of becoming a pilot.","example_zh":"许多孩子梦想成为飞行员。","scene":"中考","root_group":"v.","ipa":"/driːm ɒv/","related":["dream"]},{"word":"dress up","pos":"v.","meaning_zh":"装扮","example_en":"The children dress up for the play.","example_zh":"孩子们为演出装扮起来。","scene":"中考","root_group":"v.","ipa":"/dres ʌp/","related":["dress","up"]},{"word":"end up with","pos":"v.","meaning_zh":"以……结束","example_en":"The meal will end up with fruit.","example_zh":"这顿饭将以水果结束。","scene":"中考","root_group":"v.","ipa":"/end ʌp wɪð/","related":["end","up"]},{"word":"enjoy oneself","pos":"v.","meaning_zh":"玩得开心","example_en":"I hope you enjoy yourself at the party.","example_zh":"希望你在聚会上玩得开心。","scene":"中考","root_group":"v.","ipa":"/ɪnˈdʒɔɪ wʌnˈself/","related":["enjoy","oneself"]},{"word":"fall asleep","pos":"v.","meaning_zh":"入睡","example_en":"I often fall asleep on the sofa.","example_zh":"我常常在沙发上入睡。","scene":"中考","root_group":"v.","ipa":"/fɔːl əˈsliːp/","related":["fall","asleep"]},{"word":"fall behind","pos":"v.","meaning_zh":"落在后面","example_en":"Do not fall behind in your reading.","example_zh":"阅读别落在后面。","scene":"中考","root_group":"v.","ipa":"/fɔːl bɪˈhaɪnd/","related":["fall","behind"]},{"word":"fall down","pos":"v.","meaning_zh":"摔倒","example_en":"Be careful, or you will fall down.","example_zh":"小心，不然你会摔倒。","scene":"中考","root_group":"v.","ipa":"/fɔːl daʊn/","related":["fall","down"]},{"word":"fall ill","pos":"v.","meaning_zh":"生病","example_en":"He may fall ill if he skips meals.","example_zh":"如果他不吃饭，可能会生病。","scene":"中考","root_group":"v.","ipa":"/fɔːl ɪl/","related":["fall","ill"]},{"word":"fall in love with","pos":"v.","meaning_zh":"爱上","example_en":"She may fall in love with the quiet town.","example_zh":"她可能会爱上那座安静的小镇。","scene":"中考","root_group":"v.","ipa":"/fɔːl ɪn lʌv wɪð/","related":["fall","love"]},{"word":"find out","pos":"v.","meaning_zh":"查明","example_en":"Let us find out who left the note.","example_zh":"我们来查明是谁留的便条。","scene":"中考","root_group":"v.","ipa":"/faɪnd aʊt/","related":["find","out"]},{"word":"get along with","pos":"v.","meaning_zh":"与……相处","example_en":"I get along with my deskmate.","example_zh":"我和同桌相处得好。","scene":"中考","root_group":"v.","ipa":"/ɡet əˈlɒŋ wɪð/","related":["get","along"]},{"word":"get along/on with","pos":"v.","meaning_zh":"与……和睦相处","example_en":"Do you get on with your neighbours?","example_zh":"你和邻居和睦相处吗？","scene":"中考","root_group":"v.","ipa":"/ɡet əˈlɒŋ wɪð/ / /ɡet ɒn wɪð/","related":["get","along","on"]},{"word":"get angry","pos":"v.","meaning_zh":"生气","example_en":"Try not to get angry over a small mistake.","example_zh":"别为小错误生气。","scene":"中考","root_group":"v.","ipa":"/ɡet ˈæŋɡri/","related":["get","angry"]},{"word":"get back","pos":"v.","meaning_zh":"返回；取回","example_en":"What time do you get back from club?","example_zh":"你社团几点回来？","scene":"中考","root_group":"v.","ipa":"/ɡet bæk/","related":["get","back"]},{"word":"get close to","pos":"v.","meaning_zh":"靠近","example_en":"Do not get close to the edge.","example_zh":"别靠近边缘。","scene":"中考","root_group":"v.","ipa":"/ɡet kləʊs tuː/","related":["get","close"]},{"word":"get dressed","pos":"v.","meaning_zh":"穿好衣服","example_en":"I get dressed before breakfast.","example_zh":"我早饭前穿好衣服。","scene":"中考","root_group":"v.","ipa":"/ɡet drest/","related":["get","dressed"]},{"word":"get good grades","pos":"v.","meaning_zh":"取得好成绩","example_en":"She works hard to get good grades.","example_zh":"她努力学习以取得好成绩。","scene":"中考","root_group":"v.","ipa":"/ɡet ɡʊd ɡreɪdz/","related":["get","good","grades"]},{"word":"get home","pos":"v.","meaning_zh":"到家","example_en":"I get home at about five.","example_zh":"我大约五点到家。","scene":"中考","root_group":"v.","ipa":"/ɡet həʊm/","related":["get","home"]},{"word":"get in the way","pos":"v.","meaning_zh":"妨碍","example_en":"The box can get in the way of the door.","example_zh":"箱子可能会妨碍门。","scene":"中考","root_group":"v.","ipa":"/ɡet ɪn ðə weɪ/","related":["get","way"]},{"word":"get in touch with","pos":"v.","meaning_zh":"与……取得联系","example_en":"I will get in touch with the coach.","example_zh":"我会和教练取得联系。","scene":"中考","root_group":"v.","ipa":"/ɡet ɪn tʌtʃ wɪð/","related":["get","touch"]},{"word":"get into","pos":"v.","meaning_zh":"进入","example_en":"How did the cat get into the cupboard?","example_zh":"猫是怎么进柜子的？","scene":"中考","root_group":"v.","ipa":"/ɡet ˈɪntʊ/","related":["get"]},{"word":"get lost","pos":"v.","meaning_zh":"迷路","example_en":"Take a map so you do not get lost.","example_zh":"带上地图，免得迷路。","scene":"中考","root_group":"v.","ipa":"/ɡet lɒst/","related":["get","lost"]},{"word":"get mad","pos":"v.","meaning_zh":"发怒","example_en":"He may get mad when people push in line.","example_zh":"有人插队时他可能会发怒。","scene":"中考","root_group":"v.","ipa":"/ɡet mæd/","related":["get","mad"]},{"word":"get married","pos":"v.","meaning_zh":"结婚","example_en":"They want to get married in a small garden.","example_zh":"他们想在一个小花园里结婚。","scene":"中考","root_group":"v.","ipa":"/ɡet ˈmærɪd/","related":["get","married"]},{"word":"get off","pos":"v.","meaning_zh":"下车","example_en":"We get off at the next stop.","example_zh":"我们下一站下车。","scene":"中考","root_group":"v.","ipa":"/ɡet ɒf/","related":["get","off"]},{"word":"get on","pos":"v.","meaning_zh":"上车","example_en":"Get on the bus at the school gate.","example_zh":"在校门口上车。","scene":"中考","root_group":"v.","ipa":"/ɡet ɒn/","related":["get","on"]},{"word":"get on with","pos":"v.","meaning_zh":"跟某人合得来","example_en":"She can get on with her cousins.","example_zh":"她能跟表兄弟姐妹合得来。","scene":"中考","root_group":"v.","ipa":"/ɡet ɒn wɪð/","related":["get","on"]},{"word":"get out","pos":"v.","meaning_zh":"出去","example_en":"Get out of the pool when you hear the bell.","example_zh":"听到铃就从泳池出去。","scene":"中考","root_group":"v.","ipa":"/ɡet aʊt/","related":["get","out"]},{"word":"get over","pos":"v.","meaning_zh":"克服","example_en":"It takes time to get over a cold.","example_zh":"感冒好起来需要时间。","scene":"中考","root_group":"v.","ipa":"/ɡet ˈəʊvə/","related":["get","over"]},{"word":"get popular","pos":"v.","meaning_zh":"变得受欢迎","example_en":"The song may get popular very quickly.","example_zh":"这首歌可能会很快变得受欢迎。","scene":"中考","root_group":"v.","ipa":"/ɡet ˈpɒpjʊlə/","related":["get","popular"]},{"word":"get ready for","pos":"v.","meaning_zh":"为……做准备","example_en":"We get ready for the show after school.","example_zh":"放学后我们为演出做准备。","scene":"中考","root_group":"v.","ipa":"/ɡet ˈredi fɔː/","related":["get","ready"]},{"word":"get rid of","pos":"v.","meaning_zh":"除掉","example_en":"Please get rid of these old boxes.","example_zh":"请把这些旧箱子除掉。","scene":"中考","root_group":"v.","ipa":"/ɡet rɪd ɒv/","related":["get","rid"]},{"word":"get through","pos":"v.","meaning_zh":"通过；打通","example_en":"I cannot get through to the office.","example_zh":"我打不通办公室的电话。","scene":"中考","root_group":"v.","ipa":"/ɡet θruː/","related":["get","through"]},{"word":"get to","pos":"v.","meaning_zh":"到达","example_en":"What time do we get to the museum?","example_zh":"我们几点到达博物馆？","scene":"中考","root_group":"v.","ipa":"/ɡet tuː/","related":["get"]},{"word":"get together","pos":"v.","meaning_zh":"聚会","example_en":"The family will get together on New Year's Day.","example_zh":"这家人将在元旦聚会。","scene":"中考","root_group":"v.","ipa":"/ɡet təˈɡeðə/","related":["get","together"]},{"word":"get up","pos":"v.","meaning_zh":"起床","example_en":"I get up at six on weekdays.","example_zh":"工作日我六点起床。","scene":"中考","root_group":"v.","ipa":"/ɡet ʌp/","related":["get","up"]},{"word":"get used to","pos":"v.","meaning_zh":"逐渐习惯","example_en":"You will get used to the new timetable.","example_zh":"你会逐渐习惯新的时间表。","scene":"中考","root_group":"v.","ipa":"/ɡet ˈjuːst tuː/","related":["get","used"]},{"word":"give . a hand","pos":"v.","meaning_zh":"帮某人一把","example_en":"Can you give me a hand with this box?","example_zh":"你能帮我搬一下这个箱子吗？","scene":"中考","root_group":"v.","ipa":"/ɡɪv … ə hænd/","related":["give","hand"]},{"word":"give . a lift","pos":"v.","meaning_zh":"让某人搭便车","example_en":"My uncle can give me a lift to school.","example_zh":"叔叔可以让我搭车去学校。","scene":"中考","root_group":"v.","ipa":"/ɡɪv … ə lɪft/","related":["give","lift"]}]}