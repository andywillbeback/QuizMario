{"cards":[{"word":"give a speech","pos":"v.","meaning_zh":"发表演讲","example_en":"The head teacher will give a speech.","example_zh":"班主任将发表演讲。","scene":"中考","root_group":"v.","ipa":"/ɡɪv ə spiːtʃ/","related":["give","speech"]},{"word":"give away","pos":"v.","meaning_zh":"捐赠；泄露","example_en":"We give away old clothes every spring.","example_zh":"每年春天我们捐赠旧衣服。","scene":"中考","root_group":"v.","ipa":"/ɡɪv əˈweɪ/","related":["give","away"]},{"word":"give back","pos":"v.","meaning_zh":"归还","example_en":"Please give back the library book.","example_zh":"请归还图书馆的书。","scene":"中考","root_group":"v.","ipa":"/ɡɪv bæk/","related":["give","back"]},{"word":"give birth to","pos":"v.","meaning_zh":"生下","example_en":"The cat may give birth to three kittens.","example_zh":"这只猫可能会生下三只小猫。","scene":"中考","root_group":"v.","ipa":"/ɡɪv bɜːθ tuː/","related":["give","birth"]},{"word":"give in","pos":"v.","meaning_zh":"屈服","example_en":"Do not give in when the work is hard.","example_zh":"作业难的时候也别屈服。","scene":"中考","root_group":"v.","ipa":"/ɡɪv ɪn/","related":["give"]},{"word":"give off","pos":"v.","meaning_zh":"发出（光、气味）","example_en":"The flowers give off a sweet smell.","example_zh":"这些花发出甜甜的气味。","scene":"中考","root_group":"v.","ipa":"/ɡɪv ɒf/","related":["give","off"]},{"word":"give out","pos":"v.","meaning_zh":"分发","example_en":"Please give out the worksheets.","example_zh":"请把练习纸分发下去。","scene":"中考","root_group":"v.","ipa":"/ɡɪv aʊt/","related":["give","out"]},{"word":"give up","pos":"v.","meaning_zh":"放弃","example_en":"Do not give up. Try one more time.","example_zh":"别放弃，再试一次。","scene":"中考","root_group":"v.","ipa":"/ɡɪv ʌp/","related":["give","up"]},{"word":"go ahead","pos":"v.","meaning_zh":"着手；请吧","example_en":"Go ahead and ask your question.","example_zh":"请吧，问你的问题。","scene":"中考","root_group":"v.","ipa":"/ɡəʊ əˈhed/","related":["go","ahead"]},{"word":"go away","pos":"v.","meaning_zh":"离开","example_en":"The pain will go away soon.","example_zh":"疼痛很快会消失。","scene":"中考","root_group":"v.","ipa":"/ɡəʊ əˈweɪ/","related":["go","away"]},{"word":"go by","pos":"v.","meaning_zh":"（时间）过去","example_en":"Three years go by very fast.","example_zh":"三年过得很快。","scene":"中考","root_group":"v.","ipa":"/ɡəʊ baɪ/","related":["go"]},{"word":"go down","pos":"v.","meaning_zh":"下降","example_en":"The sun will go down behind the hill.","example_zh":"太阳将落到山后面。","scene":"中考","root_group":"v.","ipa":"/ɡəʊ daʊn/","related":["go","down"]},{"word":"go fishing","pos":"v.","meaning_zh":"去钓鱼","example_en":"We go fishing by the river in summer.","example_zh":"夏天我们去河边钓鱼。","scene":"中考","root_group":"v.","ipa":"/ɡəʊ ˈfɪʃɪŋ/","related":["go","fishing"]},{"word":"go for a picnic","pos":"v.","meaning_zh":"去野餐","example_en":"Let us go for a picnic if it is sunny.","example_zh":"如果天晴，我们去野餐吧。","scene":"中考","root_group":"v.","ipa":"/ɡəʊ fɔː ə ˈpɪknɪk/","related":["go","picnic"]},{"word":"go for a walk","pos":"v.","meaning_zh":"去散步","example_en":"I go for a walk after dinner.","example_zh":"晚饭后我去散步。","scene":"中考","root_group":"v.","ipa":"/ɡəʊ fɔː ə wɔːk/","related":["go","walk"]},{"word":"go home","pos":"v.","meaning_zh":"回家","example_en":"We go home together on Wednesday.","example_zh":"星期三我们一起回家。","scene":"中考","root_group":"v.","ipa":"/ɡəʊ həʊm/","related":["go","home"]},{"word":"go on","pos":"v.","meaning_zh":"接着做","example_en":"Go on with your story, please.","example_zh":"请接着讲你的故事。","scene":"中考","root_group":"v.","ipa":"/ɡəʊ ɒn/","related":["go","on"]},{"word":"go out","pos":"v.","meaning_zh":"出门","example_en":"I do not go out when it storms.","example_zh":"下暴雨时我不出门。","scene":"中考","root_group":"v.","ipa":"/ɡəʊ aʊt/","related":["go","out"]},{"word":"go over","pos":"v.","meaning_zh":"复习","example_en":"Let us go over the new words.","example_zh":"我们复习一下生词吧。","scene":"中考","root_group":"v.","ipa":"/ɡəʊ ˈəʊvə/","related":["go","over"]},{"word":"go shopping","pos":"v.","meaning_zh":"去购物","example_en":"Mum will go shopping on Sunday morning.","example_zh":"妈妈星期天早上会去购物。","scene":"中考","root_group":"v.","ipa":"/ɡəʊ ˈʃɒpɪŋ/","related":["go","shopping"]},{"word":"go straight","pos":"v.","meaning_zh":"直走","example_en":"Go straight and turn at the bank.","example_zh":"直走，到银行再转弯。","scene":"中考","root_group":"v.","ipa":"/ɡəʊ streɪt/","related":["go","straight"]},{"word":"go swimming","pos":"v.","meaning_zh":"去游泳","example_en":"We go swimming twice a week.","example_zh":"我们一周去游泳两次。","scene":"中考","root_group":"v.","ipa":"/ɡəʊ ˈswɪmɪŋ/","related":["go","swimming"]},{"word":"go through","pos":"v.","meaning_zh":"经历；仔细查看","example_en":"She has to go through the form again.","example_zh":"她得再仔细看一遍表格。","scene":"中考","root_group":"v.","ipa":"/ɡəʊ θruː/","related":["go","through"]},{"word":"go to bed","pos":"v.","meaning_zh":"去睡觉","example_en":"I go to bed at nine.","example_zh":"我九点去睡觉。","scene":"中考","root_group":"v.","ipa":"/ɡəʊ tuː bed/","related":["go","bed"]},{"word":"go to school","pos":"v.","meaning_zh":"去上学","example_en":"The children go to school by bus.","example_zh":"孩子们乘公交去上学。","scene":"中考","root_group":"v.","ipa":"/ɡəʊ tuː skuːl/","related":["go","school"]},{"word":"go up","pos":"v.","meaning_zh":"上升","example_en":"Ticket prices go up in July.","example_zh":"七月票价上升。","scene":"中考","root_group":"v.","ipa":"/ɡəʊ ʌp/","related":["go","up"]},{"word":"go wrong","pos":"v.","meaning_zh":"出毛病","example_en":"Something may go wrong with the printer.","example_zh":"打印机可能会出毛病。","scene":"中考","root_group":"v.","ipa":"/ɡəʊ rɒŋ/","related":["go","wrong"]},{"word":"grow up","pos":"v.","meaning_zh":"长大","example_en":"I want to be a nurse when I grow up.","example_zh":"我长大后想当护士。","scene":"中考","root_group":"v.","ipa":"/ɡrəʊ ʌp/","related":["grow","up"]},{"word":"have a chance","pos":"v.","meaning_zh":"有机会","example_en":"You will have a chance to try again.","example_zh":"你会有机会再试一次。","scene":"中考","root_group":"v.","ipa":"/hæv ə tʃɑːns/","related":["have","chance"]},{"word":"have a cold","pos":"v.","meaning_zh":"得了感冒","example_en":"I have a cold, so I will rest today.","example_zh":"我得了感冒，所以今天休息。","scene":"中考","root_group":"v.","ipa":"/hæv ə kəʊld/","related":["have","cold"]},{"word":"have a fever","pos":"v.","meaning_zh":"发烧","example_en":"I have a fever and need water.","example_zh":"我发烧了，需要喝水。","scene":"中考","root_group":"v.","ipa":"/hæv ə ˈfiːvə/","related":["have","fever"]},{"word":"have a good time","pos":"v.","meaning_zh":"过得愉快","example_en":"Have a good time at the zoo.","example_zh":"祝你在动物园过得愉快。","scene":"中考","root_group":"v.","ipa":"/hæv ə ɡʊd taɪm/","related":["have","good","time"]},{"word":"have a headache","pos":"v.","meaning_zh":"头疼","example_en":"I have a headache after the long ride.","example_zh":"坐了很久的车，我头疼。","scene":"中考","root_group":"v.","ipa":"/hæv ə ˈhedeɪk/","related":["have","headache"]},{"word":"have a lesson","pos":"v.","meaning_zh":"上课","example_en":"We have a lesson at half past two.","example_zh":"我们两点半上课。","scene":"中考","root_group":"v.","ipa":"/hæv ə ˈlesən/","related":["have","lesson"]},{"word":"have a look","pos":"v.","meaning_zh":"看一看","example_en":"May I have a look at your photo?","example_zh":"我可以看一看你的照片吗？","scene":"中考","root_group":"v.","ipa":"/hæv ə lʊk/","related":["have","look"]},{"word":"have a party","pos":"v.","meaning_zh":"举办聚会","example_en":"We have a party at the end of term.","example_zh":"我们在学期末举办聚会。","scene":"中考","root_group":"v.","ipa":"/hæv ə ˈpɑːti/","related":["have","party"]},{"word":"have a picnic","pos":"v.","meaning_zh":"野餐","example_en":"They have a picnic under the trees.","example_zh":"他们在树下野餐。","scene":"中考","root_group":"v.","ipa":"/hæv ə ˈpɪknɪk/","related":["have","picnic"]},{"word":"have a rest","pos":"v.","meaning_zh":"休息一下","example_en":"Sit down and have a rest.","example_zh":"坐下来休息一下。","scene":"中考","root_group":"v.","ipa":"/hæv ə rest/","related":["have","rest"]},{"word":"have a talk","pos":"v.","meaning_zh":"谈一谈","example_en":"The teacher wants to have a talk with you.","example_zh":"老师想和你谈一谈。","scene":"中考","root_group":"v.","ipa":"/hæv ə tɔːk/","related":["have","talk"]},{"word":"have a test","pos":"v.","meaning_zh":"参加测验","example_en":"We have a test on verbs tomorrow.","example_zh":"我们明天有动词测验。","scene":"中考","root_group":"v.","ipa":"/hæv ə test/","related":["have","test"]},{"word":"have a try","pos":"v.","meaning_zh":"试一试","example_en":"This puzzle is fun. Have a try.","example_zh":"这个谜题很好玩，试一试。","scene":"中考","root_group":"v.","ipa":"/hæv ə traɪ/","related":["have","try"]},{"word":"have an idea","pos":"v.","meaning_zh":"有个主意","example_en":"I have an idea for the poster.","example_zh":"我对海报有个主意。","scene":"中考","root_group":"v.","ipa":"/hæv ən aɪˈdɪə/","related":["have","idea"]},{"word":"have breakfast","pos":"v.","meaning_zh":"吃早餐","example_en":"We have breakfast at seven.","example_zh":"我们七点吃早餐。","scene":"中考","root_group":"v.","ipa":"/hæv ˈbrekfəst/","related":["have","breakfast"]},{"word":"have fun","pos":"v.","meaning_zh":"玩得高兴","example_en":"Have fun at the music club.","example_zh":"在音乐社团玩得高兴。","scene":"中考","root_group":"v.","ipa":"/hæv fʌn/","related":["have","fun"]},{"word":"have sports","pos":"v.","meaning_zh":"进行体育活动","example_en":"We have sports after the third lesson.","example_zh":"第三节课后我们进行体育活动。","scene":"中考","root_group":"v.","ipa":"/hæv spɔːts/","related":["have","sports"]},{"word":"have to","pos":"v.","meaning_zh":"必须","example_en":"I have to finish this page tonight.","example_zh":"我今晚必须完成这一页。","scene":"中考","root_group":"v.","ipa":"/hæv tuː/","related":["have"]},{"word":"hear from","pos":"v.","meaning_zh":"收到……的来信","example_en":"I hope to hear from my pen friend.","example_zh":"我希望收到笔友的来信。","scene":"中考","root_group":"v.","ipa":"/hɪə frɒm/","related":["hear"]}]}