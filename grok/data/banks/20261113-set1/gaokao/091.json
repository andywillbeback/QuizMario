{"cards":[{"word":"hand over","pos":"v.","meaning_zh":"移交","example_en":"Please hand over the lab keys.","example_zh":"请移交实验室钥匙。","scene":"高考","root_group":"v.","ipa":"/hænd ˈəʊvə/","related":["hand","over"]},{"word":"have a cold","pos":"v.","meaning_zh":"得了感冒","example_en":"I have a cold, so I will rest today.","example_zh":"我得了感冒，所以今天休息。","scene":"高考","root_group":"v.","ipa":"/hæv ə kəʊld/","related":["have","cold"]},{"word":"have a fever","pos":"v.","meaning_zh":"发烧","example_en":"I have a fever and need water.","example_zh":"我发烧了，需要喝水。","scene":"高考","root_group":"v.","ipa":"/hæv ə ˈfiːvə/","related":["have","fever"]},{"word":"have a good time","pos":"v.","meaning_zh":"过得愉快","example_en":"Have a good time at the zoo.","example_zh":"祝你在动物园过得愉快。","scene":"高考","root_group":"v.","ipa":"/hæv ə ɡʊd taɪm/","related":["have","good","time"]},{"word":"have a headache","pos":"v.","meaning_zh":"头疼","example_en":"I have a headache after the long ride.","example_zh":"坐了很久的车，我头疼。","scene":"高考","root_group":"v.","ipa":"/hæv ə ˈhedeɪk/","related":["have","headache"]},{"word":"have a look","pos":"v.","meaning_zh":"看一看","example_en":"May I have a look at your photo?","example_zh":"我可以看一看你的照片吗？","scene":"高考","root_group":"v.","ipa":"/hæv ə lʊk/","related":["have","look"]},{"word":"have a party","pos":"v.","meaning_zh":"举办聚会","example_en":"We have a party at the end of term.","example_zh":"我们在学期末举办聚会。","scene":"高考","root_group":"v.","ipa":"/hæv ə ˈpɑːti/","related":["have","party"]},{"word":"have a picnic","pos":"v.","meaning_zh":"野餐","example_en":"They have a picnic under the trees.","example_zh":"他们在树下野餐。","scene":"高考","root_group":"v.","ipa":"/hæv ə ˈpɪknɪk/","related":["have","picnic"]},{"word":"have a rest","pos":"v.","meaning_zh":"休息一下","example_en":"Sit down and have a rest.","example_zh":"坐下来休息一下。","scene":"高考","root_group":"v.","ipa":"/hæv ə rest/","related":["have","rest"]},{"word":"have a talk","pos":"v.","meaning_zh":"谈一谈","example_en":"The teacher wants to have a talk with you.","example_zh":"老师想和你谈一谈。","scene":"高考","root_group":"v.","ipa":"/hæv ə tɔːk/","related":["have","talk"]},{"word":"have a walk","pos":"v.","meaning_zh":"去散步","example_en":"We have a walk after supper.","example_zh":"晚饭后我们去散步。","scene":"高考","root_group":"v.","ipa":"/hæv ə wɔːk/","related":["have","walk"]},{"word":"have an idea","pos":"v.","meaning_zh":"有个主意","example_en":"I have an idea for the poster.","example_zh":"我对海报有个主意。","scene":"高考","root_group":"v.","ipa":"/hæv ən aɪˈdɪə/","related":["have","idea"]},{"word":"have fun","pos":"v.","meaning_zh":"玩得高兴","example_en":"Have fun at the music club.","example_zh":"在音乐社团玩得高兴。","scene":"高考","root_group":"v.","ipa":"/hæv fʌn/","related":["have","fun"]},{"word":"have trouble","pos":"v.","meaning_zh":"感到吃力","example_en":"Some readers have trouble with long sentences.","example_zh":"有些读者读长句感到吃力。","scene":"高考","root_group":"v.","ipa":"/hæv ˈtrʌbəl/","related":["have","trouble"]},{"word":"hear about","pos":"v.","meaning_zh":"听说到","example_en":"Did you hear about the science fair?","example_zh":"你听说到科学展的事了吗？","scene":"高考","root_group":"v.","ipa":"/hɪə əˈbaʊt/","related":["hear","about"]},{"word":"hear from","pos":"v.","meaning_zh":"收到……的来信","example_en":"I hope to hear from my pen friend.","example_zh":"我希望收到笔友的来信。","scene":"高考","root_group":"v.","ipa":"/hɪə frɒm/","related":["hear"]},{"word":"hold on","pos":"v.","meaning_zh":"等一下；坚持","example_en":"Hold on, I will open the door.","example_zh":"等一下，我来开门。","scene":"高考","root_group":"v.","ipa":"/həʊld ɒn/","related":["hold","on"]},{"word":"hold on to","pos":"v.","meaning_zh":"抓住不放","example_en":"Hold on to the rail on the stairs.","example_zh":"在楼梯上抓住栏杆不放。","scene":"高考","root_group":"v.","ipa":"/həʊld ɒn tuː/","related":["hold","on"]},{"word":"hold out","pos":"v.","meaning_zh":"支撑住","example_en":"They can hold out until sunset.","example_zh":"他们能支撑到日落。","scene":"高考","root_group":"v.","ipa":"/həʊld aʊt/","related":["hold","out"]},{"word":"hold up","pos":"v.","meaning_zh":"耽搁","example_en":"An accident may hold up the train.","example_zh":"事故可能会耽搁火车。","scene":"高考","root_group":"v.","ipa":"/həʊld ʌp/","related":["hold","up"]},{"word":"insist on","pos":"v.","meaning_zh":"坚决要求","example_en":"She will insist on a written reply.","example_zh":"她会坚决要求书面答复。","scene":"高考","root_group":"v.","ipa":"/ɪnˈsɪst ɒn/","related":["insist","on"]},{"word":"interfere with","pos":"v.","meaning_zh":"妨碍","example_en":"Loud music can interfere with study.","example_zh":"吵闹的音乐会妨碍学习。","scene":"高考","root_group":"v.","ipa":"/ˌɪntəˈfɪə wɪð/","related":["interfere"]},{"word":"keep a promise","pos":"v.","meaning_zh":"遵守诺言","example_en":"Please keep a promise to your partner.","example_zh":"请遵守对搭档的诺言。","scene":"高考","root_group":"v.","ipa":"/kiːp ə ˈprɒmɪs/","related":["keep","promise"]},{"word":"keep an eye on","pos":"v.","meaning_zh":"照看一眼","example_en":"Please keep an eye on the oven.","example_zh":"请照看一下烤箱。","scene":"高考","root_group":"v.","ipa":"/kiːp ən aɪ ɒn/","related":["keep","eye","on"]},{"word":"keep away from","pos":"v.","meaning_zh":"远离","example_en":"Keep away from the deep water.","example_zh":"远离深水区。","scene":"高考","root_group":"v.","ipa":"/kiːp əˈweɪ frɒm/","related":["keep","away"]},{"word":"keep fit","pos":"v.","meaning_zh":"保持身体健康","example_en":"Daily walks help me keep fit.","example_zh":"每天走路帮助我保持身体健康。","scene":"高考","root_group":"v.","ipa":"/kiːp fɪt/","related":["keep","fit"]},{"word":"keep in mind","pos":"v.","meaning_zh":"记住","example_en":"Keep in mind that the gate closes at six.","example_zh":"记住大门六点关闭。","scene":"高考","root_group":"v.","ipa":"/kiːp ɪn maɪnd/","related":["keep","mind"]},{"word":"keep in touch","pos":"v.","meaning_zh":"保持联络","example_en":"Let us keep in touch during the holiday.","example_zh":"假期里我们保持联络吧。","scene":"高考","root_group":"v.","ipa":"/kiːp ɪn tʌtʃ/","related":["keep","touch"]},{"word":"keep pace with","pos":"v.","meaning_zh":"与……同步前进","example_en":"It is hard to keep pace with new terms.","example_zh":"很难与新术语同步前进。","scene":"高考","root_group":"v.","ipa":"/kiːp peɪs wɪð/","related":["keep","pace"]},{"word":"keep up","pos":"v.","meaning_zh":"保持；继续","example_en":"Keep up the good work.","example_zh":"继续保持这样好的表现。","scene":"高考","root_group":"v.","ipa":"/kiːp ʌp/","related":["keep","up"]},{"word":"keep up with","pos":"v.","meaning_zh":"跟上班里进度","example_en":"She reads daily to keep up with the class.","example_zh":"她每天阅读以跟上班里进度。","scene":"高考","root_group":"v.","ipa":"/kiːp ʌp wɪð/","related":["keep","up"]},{"word":"laugh at","pos":"v.","meaning_zh":"嘲笑","example_en":"It is unkind to laugh at mistakes.","example_zh":"嘲笑错误是不友善的。","scene":"高考","root_group":"v.","ipa":"/lɑːf æt/","related":["laugh"]},{"word":"learn about","pos":"v.","meaning_zh":"得知了解","example_en":"We learn about ancient trade routes.","example_zh":"我们得知了解古代贸易路线。","scene":"高考","root_group":"v.","ipa":"/lɜːn əˈbaʊt/","related":["learn","about"]},{"word":"learn from","pos":"v.","meaning_zh":"向……学习","example_en":"We can learn from our mistakes.","example_zh":"我们可以从错误中学习。","scene":"高考","root_group":"v.","ipa":"/lɜːn frɒm/","related":["learn"]},{"word":"leave out","pos":"v.","meaning_zh":"遗漏","example_en":"Do not leave out the date.","example_zh":"不要遗漏日期。","scene":"高考","root_group":"v.","ipa":"/liːv aʊt/","related":["leave","out"]},{"word":"let alone","pos":"v.","meaning_zh":"更不用说","example_en":"He cannot boil an egg, let alone cook a meal.","example_zh":"他连鸡蛋都不会煮，更不用说做一顿饭。","scene":"高考","root_group":"v.","ipa":"/let əˈləʊn/","related":["let","alone"]},{"word":"let down","pos":"v.","meaning_zh":"使失望","example_en":"I will not let down my team.","example_zh":"我不会让队友失望。","scene":"高考","root_group":"v.","ipa":"/let daʊn/","related":["let","down"]},{"word":"listen to","pos":"v.","meaning_zh":"听","example_en":"I listen to the news every evening.","example_zh":"我每天晚上听新闻。","scene":"高考","root_group":"v.","ipa":"/ˈlɪsən tuː/","related":["listen"]},{"word":"live up to","pos":"v.","meaning_zh":"不辜负","example_en":"Try to live up to the team plan.","example_zh":"尽量不辜负队伍的计划。","scene":"高考","root_group":"v.","ipa":"/lɪv ʌp tuː/","related":["live","up"]},{"word":"look after","pos":"v.","meaning_zh":"照顾","example_en":"I look after my cousin on Saturday.","example_zh":"星期六我照顾表弟。","scene":"高考","root_group":"v.","ipa":"/lʊk ˈɑːftə/","related":["look","after"]},{"word":"look at","pos":"v.","meaning_zh":"看","example_en":"Look at the board, please.","example_zh":"请看黑板。","scene":"高考","root_group":"v.","ipa":"/lʊk æt/","related":["look"]},{"word":"look down on","pos":"v.","meaning_zh":"看不起","example_en":"Do not look down on a slow starter.","example_zh":"不要看不起起步慢的人。","scene":"高考","root_group":"v.","ipa":"/lʊk daʊn ɒn/","related":["look","down","on"]},{"word":"look for","pos":"v.","meaning_zh":"寻找","example_en":"I look for my blue pen every morning.","example_zh":"我每天早上寻找我的蓝笔。","scene":"高考","root_group":"v.","ipa":"/lʊk fɔː/","related":["look"]},{"word":"look forward to","pos":"v.","meaning_zh":"期待","example_en":"I look forward to the winter holiday.","example_zh":"我期待寒假。","scene":"高考","root_group":"v.","ipa":"/lʊk ˈfɔːwəd tuː/","related":["look","forward"]},{"word":"look into","pos":"v.","meaning_zh":"调查","example_en":"The school will look into the broken window.","example_zh":"学校会调查打破的窗户。","scene":"高考","root_group":"v.","ipa":"/lʊk ˈɪntʊ/","related":["look"]},{"word":"look out for","pos":"v.","meaning_zh":"留心防范","example_en":"Look out for wet steps near the lab.","example_zh":"留心防范实验室附近湿滑的台阶。","scene":"高考","root_group":"v.","ipa":"/lʊk aʊt fɔː/","related":["look","out"]},{"word":"look up","pos":"v.","meaning_zh":"查阅；抬头看","example_en":"Look up the word in a dictionary.","example_zh":"在词典里查阅这个词。","scene":"高考","root_group":"v.","ipa":"/lʊk ʌp/","related":["look","up"]}]}