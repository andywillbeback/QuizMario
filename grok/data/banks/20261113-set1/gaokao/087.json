{"cards":[{"word":"be excited about/for","pos":"adj.","meaning_zh":"为……感到兴奋","example_en":"The class is excited about the science fair.","example_zh":"全班为科学展感到兴奋。","scene":"高考","root_group":"adj.","ipa":"/biː ɪkˈsaɪtɪd əˈbaʊt/ / /biː ɪkˈsaɪtɪd fɔː/","related":["be","excited","about","for"]},{"word":"be faced with","pos":"adj.","meaning_zh":"面临","example_en":"We are faced with a hard choice.","example_zh":"我们面临一个艰难的选择。","scene":"高考","root_group":"adj.","ipa":"/biː feɪsd wɪð/","related":["be","faced"]},{"word":"be familiar to","pos":"adj.","meaning_zh":"为……所熟悉","example_en":"This tune is familiar to most students.","example_zh":"这段曲子为大多数学生所熟悉。","scene":"高考","root_group":"adj.","ipa":"/biː fəˈmɪlɪə tuː/","related":["be","familiar"]},{"word":"be familiar with","pos":"adj.","meaning_zh":"熟悉","example_en":"Are you familiar with this song?","example_zh":"你熟悉这首歌吗？","scene":"高考","root_group":"adj.","ipa":"/biː fəˈmɪlɪə wɪð/","related":["be","familiar"]},{"word":"be famous for","pos":"adj.","meaning_zh":"因……闻名","example_en":"Hangzhou is famous for its lake.","example_zh":"杭州因西湖闻名。","scene":"高考","root_group":"adj.","ipa":"/biː ˈfeɪməs fɔː/","related":["be","famous"]},{"word":"be fed up with","pos":"adj.","meaning_zh":"厌烦透了","example_en":"I am fed up with the building noise.","example_zh":"我对楼里的噪音厌烦透了。","scene":"高考","root_group":"adj.","ipa":"/biː fed ʌp wɪð/","related":["be","fed","up"]},{"word":"be fit for","pos":"adj.","meaning_zh":"适合担任","example_en":"Lin is fit for the role of captain.","example_zh":"林适合担任队长。","scene":"高考","root_group":"adj.","ipa":"/biː fɪt fɔː/","related":["be","fit"]},{"word":"be fond of","pos":"adj.","meaning_zh":"喜爱","example_en":"Grandma is fond of morning walks.","example_zh":"奶奶喜爱早晨散步。","scene":"高考","root_group":"adj.","ipa":"/biː fɒnd ɒv/","related":["be","fond"]},{"word":"be friendly to","pos":"adj.","meaning_zh":"对……友好","example_en":"Please be friendly to new students.","example_zh":"请对新同学友好。","scene":"高考","root_group":"adj.","ipa":"/biː ˈfrendli tuː/","related":["be","friendly"]},{"word":"be full of","pos":"adj.","meaning_zh":"充满","example_en":"The park is full of families on Sunday.","example_zh":"星期天公园里充满了家人。","scene":"高考","root_group":"adj.","ipa":"/biː fʊl ɒv/","related":["be","full"]},{"word":"be good at","pos":"adj.","meaning_zh":"擅长","example_en":"Anna is good at maths and music.","example_zh":"安娜擅长数学和音乐。","scene":"高考","root_group":"adj.","ipa":"/biː ɡʊd æt/","related":["be","good"]},{"word":"be good for","pos":"adj.","meaning_zh":"对……有益","example_en":"Vegetables are good for your health.","example_zh":"蔬菜对健康有益。","scene":"高考","root_group":"adj.","ipa":"/biː ɡʊd fɔː/","related":["be","good"]},{"word":"be grateful to","pos":"adj.","meaning_zh":"感激","example_en":"We are grateful to our debate coach.","example_zh":"我们感激辩论教练。","scene":"高考","root_group":"adj.","ipa":"/biː ˈɡreɪtfəl tuː/","related":["be","grateful"]},{"word":"be harmful to","pos":"adj.","meaning_zh":"有害于","example_en":"Smoke is harmful to children.","example_zh":"烟有害于儿童。","scene":"高考","root_group":"adj.","ipa":"/biː ˈhɑːmfəl tuː/","related":["be","harmful"]},{"word":"be inferior to","pos":"adj.","meaning_zh":"不如","example_en":"This draft is inferior to your first one.","example_zh":"这稿不如你的第一稿。","scene":"高考","root_group":"adj.","ipa":"/biː ɪnˈfɪərɪə tuː/","related":["be","inferior"]},{"word":"be interested in","pos":"adj.","meaning_zh":"对……感兴趣","example_en":"He is interested in science stories.","example_zh":"他对科学故事感兴趣。","scene":"高考","root_group":"adj.","ipa":"/biː ˈɪntrestɪd ɪn/","related":["be","interested"]},{"word":"be involved in","pos":"adj.","meaning_zh":"参与","example_en":"He is involved in the school play.","example_zh":"他参与了校园剧。","scene":"高考","root_group":"adj.","ipa":"/biː ɪnˈvɒlvd ɪn/","related":["be","involved"]},{"word":"be keen on","pos":"adj.","meaning_zh":"热衷于","example_en":"She is keen on public speaking.","example_zh":"她热衷于当众发言。","scene":"高考","root_group":"adj.","ipa":"/biː kiːn ɒn/","related":["be","keen","on"]},{"word":"be known as","pos":"adj.","meaning_zh":"被称为","example_en":"She is known as a kind class monitor.","example_zh":"她被称为一位和气的班长。","scene":"高考","root_group":"adj.","ipa":"/biː nəʊn æz/","related":["be","known"]},{"word":"be known for","pos":"adj.","meaning_zh":"因……出名","example_en":"The shop is known for fresh bread.","example_zh":"这家店因新鲜面包出名。","scene":"高考","root_group":"adj.","ipa":"/biː nəʊn fɔː/","related":["be","known"]},{"word":"be late for","pos":"adj.","meaning_zh":"迟到","example_en":"Do not be late for the morning meeting.","example_zh":"早上的会别迟到。","scene":"高考","root_group":"adj.","ipa":"/biː leɪt fɔː/","related":["be","late"]},{"word":"be likely to","pos":"adj.","meaning_zh":"很可能","example_en":"It is likely to snow tonight.","example_zh":"今晚很可能会下雪。","scene":"高考","root_group":"adj.","ipa":"/biː ˈlaɪkli tuː/","related":["be","likely"]},{"word":"be nervous about","pos":"adj.","meaning_zh":"对……紧张","example_en":"I am nervous about the oral test.","example_zh":"我对口试感到紧张。","scene":"高考","root_group":"adj.","ipa":"/biː ˈnɜːvəs əˈbaʊt/","related":["be","nervous","about"]},{"word":"be particular about","pos":"adj.","meaning_zh":"对……讲究","example_en":"He is particular about handwriting.","example_zh":"他很讲究书写。","scene":"高考","root_group":"adj.","ipa":"/biː pəˈtɪkjʊlə əˈbaʊt/","related":["be","particular","about"]},{"word":"be patient with","pos":"adj.","meaning_zh":"对……有耐心","example_en":"A good teacher is patient with students.","example_zh":"好老师对学生有耐心。","scene":"高考","root_group":"adj.","ipa":"/biː ˈpeɪʃənt wɪð/","related":["be","patient"]},{"word":"be polite to","pos":"adj.","meaning_zh":"对……有礼貌","example_en":"We should be polite to guests.","example_zh":"我们应当对客人有礼貌。","scene":"高考","root_group":"adj.","ipa":"/biː pəˈlaɪt tuː/","related":["be","polite"]},{"word":"be popular with","pos":"adj.","meaning_zh":"受……欢迎","example_en":"The club is popular with Grade 8.","example_zh":"这个社团受八年级欢迎。","scene":"高考","root_group":"adj.","ipa":"/biː ˈpɒpjʊlə wɪð/","related":["be","popular"]},{"word":"be proud of","pos":"adj.","meaning_zh":"为……骄傲","example_en":"We are proud of our school team.","example_zh":"我们为校队骄傲。","scene":"高考","root_group":"adj.","ipa":"/biː praʊd ɒv/","related":["be","proud"]},{"word":"be ready for","pos":"adj.","meaning_zh":"为……做好准备","example_en":"Are you ready for the sports day?","example_zh":"你为运动会做好准备了吗？","scene":"高考","root_group":"adj.","ipa":"/biː ˈredi fɔː/","related":["be","ready"]},{"word":"be ready to","pos":"adj.","meaning_zh":"乐意","example_en":"She is ready to explain the chart.","example_zh":"她乐意讲解这张图。","scene":"高考","root_group":"adj.","ipa":"/biː ˈredi tuː/","related":["be","ready"]},{"word":"be related to","pos":"adj.","meaning_zh":"与……相关","example_en":"This word is related to travel.","example_zh":"这个词与旅行相关。","scene":"高考","root_group":"adj.","ipa":"/biː rɪˈleɪtɪd tuː/","related":["be","related"]},{"word":"be relevant to","pos":"adj.","meaning_zh":"与题目相关","example_en":"The chart is relevant to the question.","example_zh":"这张图与题目相关。","scene":"高考","root_group":"adj.","ipa":"/biː ˈrelɪvənt tuː/","related":["be","relevant"]},{"word":"be responsible for","pos":"adj.","meaning_zh":"对……负责","example_en":"I am responsible for watering the plants.","example_zh":"我负责给植物浇水。","scene":"高考","root_group":"adj.","ipa":"/biː rɪˈspɒnsɪbəl fɔː/","related":["be","responsible"]},{"word":"be rude to","pos":"adj.","meaning_zh":"对……无礼","example_en":"It is wrong to be rude to classmates.","example_zh":"对同学无礼是不对的。","scene":"高考","root_group":"adj.","ipa":"/biː ruːd tuː/","related":["be","rude"]},{"word":"be satisfied with","pos":"adj.","meaning_zh":"对……满意","example_en":"The coach is satisfied with our practice.","example_zh":"教练对我们的练习满意。","scene":"高考","root_group":"adj.","ipa":"/biː ˈsætɪˌsfaɪd wɪð/","related":["be","satisfied"]},{"word":"be sensitive to","pos":"adj.","meaning_zh":"对……敏感","example_en":"This film is sensitive to bright light.","example_zh":"这种胶片对强光敏感。","scene":"高考","root_group":"adj.","ipa":"/biː ˈsensɪˌtɪv tuː/","related":["be","sensitive"]},{"word":"be short of","pos":"adj.","meaning_zh":"缺少","example_en":"The team is short of one player.","example_zh":"队里缺少一名队员。","scene":"高考","root_group":"adj.","ipa":"/biː ʃɔːt ɒv/","related":["be","short"]},{"word":"be similar to","pos":"adj.","meaning_zh":"与……相似","example_en":"Your bag is similar to mine.","example_zh":"你的包与我的相似。","scene":"高考","root_group":"adj.","ipa":"/biː ˈsɪmɪlə tuː/","related":["be","similar"]},{"word":"be strict with","pos":"adj.","meaning_zh":"对……严格","example_en":"Mr Li is strict with our homework.","example_zh":"李老师对我们的作业很严格。","scene":"高考","root_group":"adj.","ipa":"/biː strɪkt wɪð/","related":["be","strict"]},{"word":"be subject to","pos":"adj.","meaning_zh":"视……而定","example_en":"The date is subject to change.","example_zh":"日期视情况而定，可能更改。","scene":"高考","root_group":"adj.","ipa":"/biː ˈsʌbdʒekt tuː/","related":["be","subject"]},{"word":"be suitable for","pos":"adj.","meaning_zh":"适宜于","example_en":"The hall is suitable for a concert.","example_zh":"这个大厅适宜于开音乐会。","scene":"高考","root_group":"adj.","ipa":"/biː ˈsuːtəbəl fɔː/","related":["be","suitable"]},{"word":"be supposed to","pos":"adj.","meaning_zh":"应当","example_en":"You are supposed to knock before you come in.","example_zh":"进来之前你应当先敲门。","scene":"高考","root_group":"adj.","ipa":"/biː səˈpəʊzd tuː/","related":["be","supposed"]},{"word":"be sure about","pos":"adj.","meaning_zh":"对……有把握","example_en":"I am not sure about the answer.","example_zh":"我对这个答案没有把握。","scene":"高考","root_group":"adj.","ipa":"/biː ʃʊə əˈbaʊt/","related":["be","sure","about"]},{"word":"be sure of","pos":"adj.","meaning_zh":"对……拿得准","example_en":"Are you sure of the last answer?","example_zh":"你对最后一题拿得准吗？","scene":"高考","root_group":"adj.","ipa":"/biː ʃʊə ɒv/","related":["be","sure"]},{"word":"be sure to","pos":"adj.","meaning_zh":"务必","example_en":"Be sure to write your class number.","example_zh":"务必写上你的班级号。","scene":"高考","root_group":"adj.","ipa":"/biː ʃʊə tuː/","related":["be","sure"]},{"word":"be surprised at","pos":"adj.","meaning_zh":"对……感到吃惊","example_en":"Mum is surprised at the low price.","example_zh":"妈妈对这么低的价格感到吃惊。","scene":"高考","root_group":"adj.","ipa":"/biː səˈpraɪzd æt/","related":["be","surprised"]},{"word":"be tired from","pos":"adj.","meaning_zh":"因……而累","example_en":"She is tired from the long hike.","example_zh":"她因长途徒步而累。","scene":"高考","root_group":"adj.","ipa":"/biː taɪəd frɒm/","related":["be","tired"]}]}